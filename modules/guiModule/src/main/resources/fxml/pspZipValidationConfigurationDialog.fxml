<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="nkp.pspValidator.gui.PspZipValidationConfigurationDialogController"
      fx:id="container"
      minHeight="800"
      minWidth="650"
      alignment="CENTER"
      spacing="20"
>

    <children>

        <GridPane alignment="CENTER" hgap="10" vgap="10">
            <padding>
                <Insets bottom="10" left="10" right="10" top="20"/>
            </padding>

            <!--PSP dir-->
            <Label text="Zip soubor PSP balíku"
                   GridPane.columnIndex="0"
                   GridPane.rowIndex="0"
                   GridPane.columnSpan="2"
            />
            <TextField fx:id="pspZipTextField" minWidth="250"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="0"
                       GridPane.columnSpan="1"
                       GridPane.hgrow="ALWAYS"
            />
            <Button onAction="#selectPspDir" text="Vybrat" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

            <!--FORCED-->
            <Label text="Vynutit validaci proti konkrétním verzím DMF" GridPane.columnIndex="0"
                   GridPane.columnSpan="3"
                   GridPane.rowIndex="2"/>

            <!--Monograph-->
            <CheckBox fx:id="forcedMonVersionCheckBox"
                      onAction="#forcedMonVersionChanged"
                      GridPane.columnIndex="0"
                      GridPane.rowIndex="3"
                      GridPane.halignment="RIGHT"
            />

            <Label text="Monografie" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

            <ChoiceBox fx:id="forcedMonVersionChoiceBox"
                       onAction="#forcedMonVersionChoiceboxChanged"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="3"/>


            <!--Periodical-->
            <CheckBox fx:id="forcedPerVersionCheckBox"
                      onAction="#forcedPerVersionChanged"
                      GridPane.columnIndex="0"
                      GridPane.rowIndex="4"
                      GridPane.halignment="RIGHT"
            />

            <Label text="Periodika" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

            <ChoiceBox fx:id="forcedPerVersionChoiceBox"
                       GridPane.columnIndex="2" GridPane.columnSpan="2"
                       GridPane.rowIndex="4"
                       onAction="#forcedPerVersionChoiceboxChanged"/>

            <!--Audio doc (gramophone)-->
            <CheckBox fx:id="forcedAdgVersionCheckBox"
                      onAction="#forcedAdgVersionChanged"
                      GridPane.columnIndex="0"
                      GridPane.rowIndex="5"
                      GridPane.halignment="RIGHT"
            />

            <Label text="Audio (gramodesky)" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

            <ChoiceBox fx:id="forcedAdgVersionChoiceBox"
                       GridPane.columnIndex="2" GridPane.columnSpan="2"
                       GridPane.rowIndex="5"
                       onAction="#forcedAdgVersionChoiceboxChanged"/>

            <!--Audio doc (fonocylinder)-->
            <CheckBox fx:id="forcedAdfVersionCheckBox"
                      onAction="#forcedAdfVersionChanged"
                      GridPane.columnIndex="0"
                      GridPane.rowIndex="6"
                      GridPane.halignment="RIGHT"
            />

            <Label text="Audio (fonoválečky)" GridPane.columnIndex="1" GridPane.rowIndex="6"/>

            <ChoiceBox fx:id="forcedAdfVersionChoiceBox"
                       GridPane.columnIndex="2" GridPane.columnSpan="2"
                       GridPane.rowIndex="6"
                       onAction="#forcedAdfVersionChoiceboxChanged"/>
            
            
            <!--Audio doc (audio disc)-->
            <CheckBox fx:id="forcedAdiVersionCheckBox"
                      onAction="#forcedAdiVersionChanged"
                      GridPane.columnIndex="0"
                      GridPane.rowIndex="7"
                      GridPane.halignment="RIGHT"
                />
            
            <Label text="Audio (zvukové disky)" GridPane.columnIndex="1" GridPane.rowIndex="7"/>
            
            <ChoiceBox fx:id="forcedAdiVersionChoiceBox"
                       GridPane.columnIndex="2" GridPane.columnSpan="2"
                       GridPane.rowIndex="7"
                       onAction="#forcedAdiVersionChoiceboxChanged"/>
            
            <!--Audio doc (digital audio)-->
            <CheckBox fx:id="forcedAdnVersionCheckBox"
                      onAction="#forcedAdnVersionChanged"
                      GridPane.columnIndex="0"
                      GridPane.rowIndex="8"
                      GridPane.halignment="RIGHT"
                />
            
            <Label text="Audio (bez nosiče)" GridPane.columnIndex="1" GridPane.rowIndex="8"/>
            
            <ChoiceBox fx:id="forcedAdnVersionChoiceBox"
                       GridPane.columnIndex="2" GridPane.columnSpan="2"
                       GridPane.rowIndex="8"
                       onAction="#forcedAdnVersionChoiceboxChanged"/>            
            
            
            
            <!--Digital discs-->
            <CheckBox fx:id="forcedDadVersionCheckBox"
                      onAction="#forcedDadVersionChanged"
                      GridPane.columnIndex="0"
                      GridPane.rowIndex="9"
                      GridPane.halignment="RIGHT"
            />

            <Label text="Datové disky" GridPane.columnIndex="1" GridPane.rowIndex="9"/>

            <ChoiceBox fx:id="forcedDadVersionChoiceBox"
                       GridPane.columnIndex="2" GridPane.columnSpan="2"
                       GridPane.rowIndex="9"
                       onAction="#forcedDadVersionChoiceboxChanged"/>


            <!--PREFERRED-->
            <Label text="Preferované verze standardů. Jsou použity, když v datech balíku chybí verze DMF."
                   GridPane.columnIndex="0"
                   GridPane.columnSpan="3"
                   GridPane.rowIndex="11"/>

            <!--Monograph-->
            <CheckBox fx:id="preferredMonVersionCheckBox"
                      onAction="#preferredMonVersionChanged"
                      GridPane.columnIndex="0"
                      GridPane.rowIndex="12"
                      GridPane.halignment="RIGHT"
            />

            <Label text="Monografie" GridPane.columnIndex="1" GridPane.rowIndex="12"/>

            <ChoiceBox fx:id="preferredMonVersionChoiceBox"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="12"
                       onAction="#preferredMonVersionChoiceboxChanged"
            />

            <!--Periodical-->
            <CheckBox fx:id="preferredPerVersionCheckBox"
                      onAction="#preferredPerVersionChanged"
                      GridPane.columnIndex="0"
                      GridPane.rowIndex="13"
                      GridPane.halignment="RIGHT"
            />

            <Label text="Periodika" GridPane.columnIndex="1" GridPane.rowIndex="13"/>

            <ChoiceBox fx:id="preferredPerVersionChoiceBox"
                       GridPane.columnIndex="2" GridPane.columnSpan="2"
                       GridPane.rowIndex="13"
                       onAction="#preferredPerVersionChoiceboxChanged"
            />

            <!--Audio doc (gramophone)-->
            <CheckBox fx:id="preferredAdgVersionCheckBox"
                      onAction="#preferredAdgVersionChanged"
                      GridPane.columnIndex="0"
                      GridPane.rowIndex="14"
                      GridPane.halignment="RIGHT"
            />

            <Label text="Audio (gramodesky)" GridPane.columnIndex="1" GridPane.rowIndex="14"/>

            <ChoiceBox fx:id="preferredAdgVersionChoiceBox"
                       GridPane.columnIndex="2" GridPane.columnSpan="2"
                       GridPane.rowIndex="14"
                       onAction="#preferredAdgVersionChoiceboxChanged"
            />

            <!--Audio doc (fonocylinders)-->
            <CheckBox fx:id="preferredAdfVersionCheckBox"
                      onAction="#preferredAdfVersionChanged"
                      GridPane.columnIndex="0"
                      GridPane.rowIndex="15"
                      GridPane.halignment="RIGHT"
            />

            <Label text="Audio (fonoválečky)" GridPane.columnIndex="1" GridPane.rowIndex="15"/>

            <ChoiceBox fx:id="preferredAdfVersionChoiceBox"
                       GridPane.columnIndex="2" GridPane.columnSpan="2"
                       GridPane.rowIndex="15"
                       onAction="#preferredAdfVersionChoiceboxChanged"
            />
            
            
            <!--Audio doc (audio disc)-->
            <CheckBox fx:id="preferredAdiVersionCheckBox"
                      onAction="#preferredAdiVersionChanged"
                      GridPane.columnIndex="0"
                      GridPane.rowIndex="16"
                      GridPane.halignment="RIGHT"
                />
            
            <Label text="Audio (zvukové disky)" GridPane.columnIndex="1" GridPane.rowIndex="16"/>
            
            <ChoiceBox fx:id="preferredAdiVersionChoiceBox"
                       GridPane.columnIndex="2" GridPane.columnSpan="2"
                       GridPane.rowIndex="16"
                       onAction="#preferredAdiVersionChoiceboxChanged"/>
            
            <!--Audio doc (digital audio)-->
            <CheckBox fx:id="preferredAdnVersionCheckBox"
                      onAction="#preferredAdnVersionChanged"
                      GridPane.columnIndex="0"
                      GridPane.rowIndex="17"
                      GridPane.halignment="RIGHT"
                />
            
            <Label text="Audio (bez nosiče)" GridPane.columnIndex="1" GridPane.rowIndex="17"/>
            
            <ChoiceBox fx:id="preferredAdnVersionChoiceBox"
                       GridPane.columnIndex="2" GridPane.columnSpan="2"
                       GridPane.rowIndex="17"
                       onAction="#preferredAdnVersionChoiceboxChanged"/>            
            
            <!--Digital discs-->
            <CheckBox fx:id="preferredDadVersionCheckBox"
                      onAction="#preferreDadVersionChanged"
                      GridPane.columnIndex="0"
                      GridPane.rowIndex="18"
                      GridPane.halignment="RIGHT"
            />

            <Label text="Datové disky" GridPane.columnIndex="1" GridPane.rowIndex="18"/>

            <ChoiceBox fx:id="preferredDadVersionChoiceBox"
                       GridPane.columnIndex="2" GridPane.columnSpan="2"
                       GridPane.rowIndex="18"
                       onAction="#preferredDadVersionChoiceboxChanged"
            />

            <!--PROTOCOLS-->
            <Label text="Vytvořit protokol v XML"
                   GridPane.columnIndex="0"
                   GridPane.rowIndex="20"
                   GridPane.columnSpan="2"
            />

            <CheckBox fx:id="createXmlLog"
                      onAction="#createXmlLogChanged"
                      GridPane.columnIndex="2"
                      GridPane.rowIndex="20"
            />

            <Label text="Vytvořit textový log"
                   GridPane.columnIndex="0"
                   GridPane.rowIndex="21"
                   GridPane.columnSpan="2"
            />

            <CheckBox fx:id="createTxtLog"
                      onAction="#createTxtLogChanged"
                      GridPane.columnIndex="2"
                      GridPane.rowIndex="21"
            />

            <!--Verbosity-->
            <Label text="Podrobnost textového logu"
                   GridPane.columnIndex="0"
                   GridPane.rowIndex="22"
            />

            <HBox GridPane.rowIndex="22"
                  GridPane.columnIndex="2"
                  GridPane.columnSpan="3"
                  spacing="8">
                <ToggleButton fx:id="verbosityLevel3"
                              selected="true"
                              text="úplně vše"
                              onAction="#onVerbositySwitched"
                />
                <ToggleButton fx:id="verbosityLevel2"
                              text="jen sekce a pravidla obsahující chyby"
                              onAction="#onVerbositySwitched"
                />
            </HBox>

            <HBox GridPane.rowIndex="23"
                  GridPane.columnIndex="2"
                  GridPane.columnSpan="3"
                  spacing="10">
                <ToggleButton fx:id="verbosityLevel1"
                              text="jen sekce obsahující chyby"
                              onAction="#onVerbositySwitched"
                />
                <ToggleButton fx:id="verbosityLevel0"
                              text="jen validní/nevalidní"
                              onAction="#onVerbositySwitched"
                />
            </HBox>

        </GridPane>

        <HBox alignment="CENTER">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10"/>
            </padding>
            <Label fx:id="errorMessageLabel" text="" textFill="#f80202"/>
        </HBox>

        <HBox alignment="CENTER" spacing="10">
            <padding>
                <Insets bottom="5" left="10" right="10" top="5"/>
            </padding>
            <Button onAction="#validate" text="Validovat"/>
            <Button onAction="#closeDialog" text="Zavřít"/>
        </HBox>

    </children>
</VBox>
