<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<!--
Hlavni okno: menu, horni lista se souhrnem validace (jen po spusteni validace), pod ni behem behu panel prubehu
a po zruseni nebo chybe hlaska, uprostred prazdny stav, hlaska
(chyba nebo zruseni pred nactenim sekci) nebo vysledky (filtr, sekce, pravidla, problemy; u skupiny baliku nad nimi
tabulka baliku) a dole stavovy radek.
Vzhled v base.css (trida main-root a nasledujici).
-->
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="nkp.pspValidator.gui.MainController"
            fx:id="container"
            styleClass="main-root">
    <top>
        <VBox>
            <MenuBar fx:id="menuBar">
                <menus>
                    <Menu fx:id="menuValidate" text="Validovat">
                        <items>
                            <MenuItem fx:id="newValidationMenuItem" onAction="#showNewValidationDialog"
                                      text="Nová validace…" accelerator="Shortcut+N"/>
                            <MenuItem fx:id="rerunMenuItem" onAction="#rerunValidation" text="Validovat znovu"
                                      accelerator="Shortcut+R" disable="true"/>
                            <MenuItem fx:id="exportCsvMenuItem" onAction="#exportGroupCsv"
                                      text="Exportovat souhrn do CSV…" disable="true"/>
                            <SeparatorMenuItem/>
                            <!--zkratka podle platformy (Cmd+. na macOS, jinde Esc) se nastavuje v MainController-->
                            <MenuItem fx:id="cancelMenuItem" onAction="#stopValidation" text="Zrušit validaci"
                                      disable="true"/>
                        </items>
                    </Menu>
                    <Menu fx:id="menuSettings" text="Nastavení">
                        <items>
                            <MenuItem fx:id="settingsMenuItem" text="Nastavení…" onAction="#showSettings"
                                      accelerator="Shortcut+Comma"/>
                        </items>
                    </Menu>
                    <Menu fx:id="menuShow" text="Zobrazit">
                        <items>
                            <MenuItem fx:id="showLogXmlMenuItem" text="Protokol XML proběhlé validace" disable="true"
                                      onAction="#showLogXml"/>
                            <MenuItem fx:id="showLogTxtMenuItem" text="Textový log proběhlé validace" disable="true"
                                      onAction="#showLogTxt"/>
                        </items>
                    </Menu>
                    <Menu text="Nápověda">
                        <items>
                            <MenuItem onAction="#showOnlineHelp" text="Online nápověda"/>
                            <SeparatorMenuItem/>
                            <MenuItem onAction="#showAboutAppDialog" text="O aplikaci"/>
                        </items>
                    </Menu>
                </menus>
            </MenuBar>

            <!--horni lista se souhrnem-->
            <HBox fx:id="header" styleClass="main-header" visible="false" managed="false">
                <VBox styleClass="main-header-text" HBox.hgrow="ALWAYS" minWidth="0">
                    <Label fx:id="headerTitle" styleClass="main-title" minWidth="0"/>
                    <Label fx:id="headerSubtitle" styleClass="main-subtitle" minWidth="0"/>
                    <HBox fx:id="headerLinks" styleClass="main-header-links">
                        <Hyperlink fx:id="xmlLogLink" text="Protokol XML" styleClass="link" onAction="#showLogXml"/>
                        <Hyperlink fx:id="txtLogLink" text="Textový log" styleClass="link" onAction="#showLogTxt"/>
                    </HBox>
                </VBox>
                <Label fx:id="verdictBadge" styleClass="verdict" minWidth="-Infinity"/>
                <Label fx:id="errorsBadge" styleClass="badge-error,header-badge" minWidth="-Infinity"/>
                <Label fx:id="warningsBadge" styleClass="badge-warning,header-badge" minWidth="-Infinity"/>
                <Label fx:id="infosBadge" styleClass="badge-info,header-badge" minWidth="-Infinity"/>
                <!--skupina baliku: pocty baliku podle vysledku-->
                <Label fx:id="groupValidBadge" styleClass="badge-ok,header-badge" minWidth="-Infinity" visible="false" managed="false"/>
                <Label fx:id="groupInvalidBadge" styleClass="badge-error,header-badge" minWidth="-Infinity" visible="false" managed="false"/>
                <Label fx:id="groupErrorBadge" styleClass="badge-warning,header-badge" minWidth="-Infinity" visible="false" managed="false"/>
                <Label fx:id="groupWaitingBadge" styleClass="badge-muted,header-badge" minWidth="-Infinity" visible="false" managed="false"/>
                <Button fx:id="rerunButton" text="Validovat znovu" styleClass="button-secondary" minWidth="-Infinity"
                        onAction="#rerunValidation"/>
                <Button fx:id="cancelButton" text="Zrušit validaci" styleClass="button-secondary" minWidth="-Infinity"
                        onAction="#stopValidation"/>
            </HBox>

            <!--prubeh validace (jen behem behu): sekce, pocty pravidel, ukazatel a bezici pravidlo-->
            <VBox fx:id="progressPane" styleClass="progress-pane" visible="false" managed="false">
                <HBox styleClass="progress-line">
                    <Label fx:id="progressTitle" styleClass="progress-title" minWidth="0" maxWidth="Infinity"
                           HBox.hgrow="ALWAYS"/>
                    <Label fx:id="progressCounts" styleClass="progress-counts" minWidth="-Infinity"/>
                </HBox>
                <ProgressBar fx:id="progressBar" styleClass="progress-main" maxWidth="Infinity" progress="-1"/>
                <Label fx:id="progressDetail" styleClass="progress-detail" minWidth="0"/>
            </VBox>

            <!--hlaska po zruseni nebo chybe validace, kdyz uz jsou zobrazene dilci vysledky-->
            <HBox fx:id="noticeBar" styleClass="notice-bar" visible="false" managed="false">
                <Label fx:id="noticeText" wrapText="true" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <StackPane>
            <!--prazdny stav: zadna validace jeste neprobehla-->
            <VBox fx:id="emptyState" styleClass="empty-state">
                <ImageView fitWidth="88" fitHeight="88" preserveRatio="true" smooth="true">
                    <image>
                        <Image url="@/img/appIcon/appIcon.iconset/icon_128x128@2x.png"/>
                    </image>
                </ImageView>
                <Label fx:id="emptyTitle" styleClass="empty-title"/>
                <Label styleClass="empty-text" wrapText="true" maxWidth="460"
                       text="Vyberte balík k validaci (adresář nebo soubor ZIP) nebo skupinu balíků. Výsledek se zobrazí tady: sekce, pravidla a nalezené problémy."/>
                <Button fx:id="emptyNewValidationButton" text="Nová validace…" styleClass="button-primary,empty-button"
                        onAction="#showNewValidationDialog"/>
                <HBox styleClass="empty-info">
                    <Label fx:id="emptyFdmfInfo" styleClass="text-muted"/>
                    <Label fx:id="emptyToolsInfo" styleClass="text-muted"/>
                    <Hyperlink text="Zkontrolovat nástroje" styleClass="link" onAction="#showSettingsTools"/>
                </HBox>
            </VBox>

            <!--hlaska misto vysledku (chyba nebo zruseni pred nactenim sekci)-->
            <VBox fx:id="messageState" styleClass="empty-state" visible="false">
                <Label fx:id="messageTitle" styleClass="empty-title"/>
                <Label fx:id="messageText" styleClass="empty-text" wrapText="true" maxWidth="560"/>
            </VBox>

            <!--vysledky: u jednoho baliku jen detailPane, u skupiny groupSplit s tabulkou baliku nad detailem vybraneho
            baliku (usporadani prepina MainController)-->
            <VBox fx:id="resultsPane" styleClass="results-pane" visible="false">
                <SplitPane fx:id="groupSplit" styleClass="group-split" orientation="VERTICAL" VBox.vgrow="ALWAYS"
                           dividerPositions="0.38">
                    <items>
                        <VBox fx:id="groupPane" styleClass="group-pane" minHeight="120">
                            <HBox styleClass="filter-bar">
                                <Label text="Zobrazit" styleClass="text-muted"/>
                                <CheckBox fx:id="groupOnlyInvalid" text="jen nevalidní"/>
                                <Label fx:id="groupShownText" styleClass="text-muted"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="exportCsvButton" text="Exportovat souhrn do CSV…" styleClass="button-secondary"
                                        minWidth="-Infinity" onAction="#exportGroupCsv"/>
                            </HBox>
                            <TableView fx:id="groupTable" styleClass="group-table" VBox.vgrow="ALWAYS"/>
                        </VBox>
                        <VBox fx:id="detailPane" minHeight="160">
                            <!--skupina: vybrany balik-->
                            <HBox fx:id="packageBar" styleClass="package-bar" visible="false" managed="false">
                                <Label fx:id="packageTitle" styleClass="package-title" minWidth="-Infinity"/>
                                <Label fx:id="packageSubtitle" styleClass="text-muted" minWidth="0" HBox.hgrow="ALWAYS"
                                       maxWidth="Infinity"/>
                                <Hyperlink fx:id="packageXmlLink" text="Protokol XML" styleClass="link" onAction="#showLogXml"
                                           minWidth="-Infinity"/>
                                <Hyperlink fx:id="packageTxtLink" text="Textový log" styleClass="link" onAction="#showLogTxt"
                                           minWidth="-Infinity"/>
                            </HBox>
                            <HBox styleClass="filter-bar">
                                <Label text="Zobrazit" styleClass="text-muted"/>
                                <CheckBox fx:id="filterErrors" text="chyby" selected="true"/>
                                <CheckBox fx:id="filterWarnings" text="varování" selected="true"/>
                                <CheckBox fx:id="filterInfos" text="informace" selected="true"/>
                                <Region styleClass="filter-gap"/>
                                <CheckBox fx:id="filterOnlyWithProblems" text="jen sekce a pravidla s problémy"/>
                            </HBox>
                            <StackPane VBox.vgrow="ALWAYS">
                                <SplitPane fx:id="resultsSplit" styleClass="results-split" dividerPositions="0.27, 0.6">
                                    <items>
                                        <VBox styleClass="result-panel" minWidth="200">
                                            <Label text="Sekce" styleClass="panel-header" maxWidth="Infinity"/>
                                            <ListView fx:id="sectionList" styleClass="result-list" VBox.vgrow="ALWAYS"/>
                                        </VBox>
                                        <VBox styleClass="result-panel" minWidth="240">
                                            <Label fx:id="rulesHeader" text="Pravidla" styleClass="panel-header" maxWidth="Infinity"/>
                                            <Label fx:id="sectionDescription" styleClass="panel-description" wrapText="true"
                                                   maxWidth="Infinity" minHeight="-Infinity"/>
                                            <ListView fx:id="ruleList" styleClass="result-list" VBox.vgrow="ALWAYS"/>
                                        </VBox>
                                        <VBox styleClass="result-panel" minWidth="300">
                                            <Label fx:id="problemsHeader" text="Problémy" styleClass="panel-header" maxWidth="Infinity"/>
                                            <Label fx:id="ruleDescription" styleClass="panel-description" wrapText="true"
                                                   maxWidth="Infinity" minHeight="-Infinity"/>
                                            <StackPane VBox.vgrow="ALWAYS">
                                                <ListView fx:id="problemList" styleClass="result-list"/>
                                                <ProgressIndicator fx:id="problemsProgressIndicator" maxWidth="48" maxHeight="48"
                                                                   visible="false"/>
                                            </StackPane>
                                        </VBox>
                                    </items>
                                </SplitPane>
                                <!--skupina: misto vysledku hlaska, kdyz vybrany balik podrobnosti nema-->
                                <VBox fx:id="packageMessagePane" styleClass="package-message" visible="false">
                                    <Label fx:id="packageMessage" styleClass="empty-text" wrapText="true" maxWidth="560"/>
                                </VBox>
                            </StackPane>
                        </VBox>
                    </items>
                </SplitPane>
            </VBox>
        </StackPane>
    </center>

    <!--stavovy radek-->
    <bottom>
        <HBox styleClass="status-bar">
            <StackPane styleClass="status-marker">
                <Region fx:id="statusDot" visible="false"/>
            </StackPane>
            <Label fx:id="statusText" minWidth="0"/>
        </HBox>
    </bottom>
</BorderPane>
