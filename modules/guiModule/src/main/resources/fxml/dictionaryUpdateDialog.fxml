<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import nkp.pspValidator.gui.DialogFrame?>
<!-- aktualizace slovníku ze sítě (Nastavení, záložka Slovníky); stav aktualizace doplňuje kontroler -->
<DialogFrame xmlns:fx="http://javafx.com/fxml"
             fx:controller="nkp.pspValidator.gui.DictionaryUpdateDialogController"
             fx:id="container"
             title="Aktualizace slovníku"
             subtitle="Slovník se stáhne znovu z adresy v nastavení a nahradí místní soubor."
>
    <content>
        <GridPane hgap="16" vgap="10">
            <columnConstraints>
                <ColumnConstraints minWidth="170" prefWidth="170"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>
            <Label styleClass="group-label" text="Slovník" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <Label fx:id="lblDictName" text="siglaInstitutionCodes" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label styleClass="group-label" text="Celkem hodnot" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <Label fx:id="lblTotalValues" text="0" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label styleClass="group-label" text="Naposledy aktualizováno" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <Label fx:id="lblLastUpdated" text="-" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        </GridPane>

        <HBox spacing="10" alignment="TOP_LEFT">
            <ProgressIndicator fx:id="progressIndicator" visible="false" managed="false"
                               prefWidth="18" prefHeight="18" maxWidth="18" maxHeight="18" minWidth="18"/>
            <Label fx:id="lblStatus" wrapText="true" minHeight="-Infinity" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
        </HBox>
    </content>

    <footerButtons>
        <Button fx:id="btnCloseOrCancel" styleClass="button-secondary" onAction="#closeOrCancel" text="Zavřít"
                minWidth="100" cancelButton="true"/>
        <Button fx:id="btnUpdate" styleClass="button-primary" onAction="#update" text="Aktualizovat"
                minWidth="110" defaultButton="true"/>
    </footerButtons>
</DialogFrame>
