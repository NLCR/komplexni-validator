<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import nkp.pspValidator.gui.DialogFrame?>
<?import nkp.pspValidator.gui.CopyableMessage?>
<!-- rozbalení souboru ZIP před validací jednoho balíku; stav rozbalování nebo chybu doplňuje kontroler -->
<DialogFrame xmlns:fx="http://javafx.com/fxml"
             fx:controller="nkp.pspValidator.gui.UnzipAndValidateDialogController"
             fx:id="container"
             title="Rozbalení souboru ZIP"
             subtitle="Před validací se balík rozbalí do nového dočasného adresáře."
>
    <content>
        <HBox spacing="12" alignment="TOP_LEFT">
            <ProgressIndicator fx:id="progressIndicator" prefWidth="18" prefHeight="18" maxWidth="18" maxHeight="18" minWidth="18"/>
            <Label fx:id="lblInfo" wrapText="true" minHeight="-Infinity" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                   text="Rozbaluji soubor…"/>
        </HBox>
        <!-- chyba rozbalení (text jde označit a zkopírovat) -->
        <CopyableMessage fx:id="errorMessage" error="true" visible="false" managed="false"/>
    </content>

    <footerButtons>
        <Button fx:id="btnCancelOrClose" styleClass="button-secondary" onAction="#cancelOrClose" text="Zrušit"
                minWidth="100" cancelButton="true"/>
    </footerButtons>
</DialogFrame>
