<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import nkp.pspValidator.gui.DialogFrame?>
<!-- vývojářský dialog (jen ve vývojářském módu) -->
<DialogFrame xmlns:fx="http://javafx.com/fxml"
             fx:controller="nkp.pspValidator.gui.dev.DevDialogController"
             fx:id="container"
             title="Vývojářský dialog"
             subtitle="Jen ve vývojářském módu."
>
    <content>
        <Label fx:id="text" text="/tmp/neco/nekde" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"/>
    </content>

    <footerButtons>
        <Button styleClass="button-primary" onAction="#closeDialog" text="Zavřít" minWidth="100"
                defaultButton="true" cancelButton="true"/>
    </footerButtons>
</DialogFrame>
