<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import nkp.pspValidator.gui.DialogFrame?>
<?import nkp.pspValidator.gui.CopyableMessage?>
<!-- inicializace validačních dat při startu aplikace: konfigurace validátoru a externí nástroje; při chybě hláška a výběr adresáře -->
<DialogFrame xmlns:fx="http://javafx.com/fxml"
             fx:controller="nkp.pspValidator.gui.ValidationDataInitializationDialogController"
             fx:id="container"
             title="Inicializace validačních dat"
             subtitle="Načítá se konfigurace validátoru (fDMF, slovníky, externí nástroje)."
>
    <content>
        <Label styleClass="group-label" text="Adresář s konfigurací validátoru"/>
        <TextField fx:id="rootDirTextfield" editable="false" focusTraversable="false"/>

        <HBox fx:id="progressBox" spacing="10" alignment="CENTER_LEFT">
            <ProgressIndicator fx:id="progressIndicator" prefWidth="18" prefHeight="18" maxWidth="18" maxHeight="18"/>
            <Label styleClass="text-muted" text="Načítám konfiguraci…"/>
        </HBox>

        <Label fx:id="noticeLabel" styleClass="notice-warning" wrapText="true" maxWidth="Infinity" minHeight="-Infinity"
               visible="false" managed="false"/>

        <CopyableMessage fx:id="errorLabel" error="true"/>
    </content>

    <footerButtons>
        <Button fx:id="btnContinue" styleClass="button-primary" onAction="#continueInApp" text="Pokračovat"
                minWidth="100" visible="false" managed="false"/>
        <Button fx:id="btnUseDefaultConfig" styleClass="button-secondary" onAction="#useDefaultConfig"
                text="Použít konfiguraci dodanou s aplikací" minWidth="-Infinity" visible="false" managed="false"/>
        <Button fx:id="btnSetFdmfsRootDir" styleClass="button-primary" onAction="#setFdmfsRootDir"
                text="Nastavit adresář s konfigurací…" minWidth="-Infinity" defaultButton="true"/>
    </footerButtons>
</DialogFrame>
