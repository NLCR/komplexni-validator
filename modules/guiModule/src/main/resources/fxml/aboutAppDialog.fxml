<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import nkp.pspValidator.gui.DialogFrame?>
<DialogFrame xmlns:fx="http://javafx.com/fxml"
             fx:controller="nkp.pspValidator.gui.AboutAppDialogController"
             fx:id="container"
             title="Komplexní validátor"
             subtitle="Validace balíků podle standardu Definice metadatových formátů pro digitalizaci"
>
    <headerGraphic>
        <ImageView fitWidth="64" fitHeight="64" preserveRatio="true" smooth="true">
            <image>
                <Image url="@/img/appIcon/appIcon.iconset/icon_128x128.png"/>
            </image>
        </ImageView>
    </headerGraphic>

    <content>
        <Label styleClass="text-muted" wrapText="true" minHeight="-Infinity"
               text="Komplexní validátor byl vyvinut pro Národní knihovnu České republiky. Nástroj je určený k validaci balíků (PSP a dalších) podle standardu Definice metadatových formátů pro digitalizaci."
        />
        <GridPane alignment="CENTER" hgap="10" vgap="10">
            <padding>
                <Insets bottom="0" left="0" right="0" top="6"/>
            </padding>


            <Label styleClass="group-label" text="Standardy pro metadata"
                   GridPane.rowIndex="0"
                   GridPane.columnIndex="0"
                   minWidth="150"
            />
            <Hyperlink styleClass="link" text="http://www.ndk.cz/standardy-digitalizace/metadata"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="2"
                       GridPane.hgrow="ALWAYS"
                       onAction="#openHyperlink"
            />

            <Label styleClass="group-label" text="Web projektu"
                   GridPane.rowIndex="1"
                   GridPane.columnIndex="0"
            />
            <Hyperlink styleClass="link" text="https://github.com/NLCR/komplexni-validator"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="2"
                       GridPane.hgrow="ALWAYS"
                       onAction="#openHyperlink"
            />

            <Label styleClass="group-label" text="Verze programu"
                   GridPane.rowIndex="2"
                   GridPane.columnIndex="0"
            />
            <Text fx:id="versionText"
                  GridPane.rowIndex="2"
                  GridPane.columnIndex="2"
                  GridPane.hgrow="ALWAYS"
                  text="1.0"
            />

            <Label styleClass="group-label" text="Datum sestavení"
                   GridPane.rowIndex="3"
                   GridPane.columnIndex="0"
            />
            <Text text="1. 12. 2016"
                  GridPane.rowIndex="3"
                  GridPane.columnIndex="2"
                  GridPane.hgrow="ALWAYS"
                  fx:id="buildDateText"
            />

            <Label styleClass="group-label" text="Konfigurační soubory"
                   GridPane.rowIndex="4"
                   GridPane.columnIndex="0"
            />
            <Text text="/Users/martin/IdeaProjects/komplexni-validator/sharedModule/src/main/resources/nkp/pspValidator/shared/validatorConfig"
                  GridPane.rowIndex="4"
                  GridPane.columnIndex="2"
                  GridPane.hgrow="ALWAYS"
                  fx:id="configDirText"
                  wrappingWidth="400"
            />
            <Button
                    styleClass="button-secondary"
                    text="Otevřít"
                    GridPane.rowIndex="4"
                    GridPane.columnIndex="3"
                    GridPane.hgrow="ALWAYS"
                    onAction="#openConfigDir"
                    minWidth="65"
            />

            <Label styleClass="group-label" text="Adresář s logy"
                   GridPane.rowIndex="5"
                   GridPane.columnIndex="0"
            />
            <Text text="/Users/martin/IdeaProjects/komplexni-validator/sharedModule/src/main/resources/nkp/pspValidator/shared/validatorConfig"
                  GridPane.rowIndex="5"
                  GridPane.columnIndex="2"
                  GridPane.hgrow="ALWAYS"
                  fx:id="logsDirText"
                  wrappingWidth="400"
            />

            <Button
                    styleClass="button-secondary"
                    text="Otevřít"
                    GridPane.rowIndex="5"
                    GridPane.columnIndex="3"
                    GridPane.hgrow="ALWAYS"
                    onAction="#openLogsDir"
                    minWidth="65"
            />

            <Button
                    styleClass="button-secondary"
                    text="Změnit"
                    GridPane.rowIndex="5"
                    GridPane.columnIndex="4"
                    GridPane.hgrow="ALWAYS"
                    onAction="#changeLogsDir"
                    minWidth="65"
            />

            <Label styleClass="group-label" text="Vývojářský mód"
                   fx:id="devModeLabel"
                   GridPane.rowIndex="6"
                   GridPane.columnIndex="0"
            />
            <Text fx:id="devModeText"
                  GridPane.rowIndex="6"
                  GridPane.columnIndex="2"
                  GridPane.hgrow="ALWAYS"
                  text="Ano, tuto verzi nepoužívejte pro produkční účely!"
            />

        </GridPane>
    </content>

    <footerButtons>
        <Button styleClass="button-primary" onAction="#closeDialog" text="OK" minWidth="100" defaultButton="true"/>
    </footerButtons>
</DialogFrame>
