<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import nkp.pspValidator.gui.DialogFrame?>
<!-- hodnoty slovníku (Nastavení, záložka Slovníky); nadpis, podtitul a počet hodnot v patičce doplňuje kontroler -->
<DialogFrame xmlns:fx="http://javafx.com/fxml"
             fx:controller="nkp.pspValidator.gui.DictionaryContentDialogController"
             fx:id="container"
             title="Slovník"
>
    <content>
        <Hyperlink fx:id="specHyperlink" styleClass="link" onAction="#openHyperlink" wrapText="true"
                   text="https://www.loc.gov/marc/relators/relaterm.html"/>
        <ListView fx:id="listView" VBox.vgrow="ALWAYS"/>
    </content>

    <footerButtons>
        <Button styleClass="button-primary" onAction="#closeDialog" text="Zavřít" minWidth="100"
                defaultButton="true" cancelButton="true"/>
    </footerButtons>
</DialogFrame>
