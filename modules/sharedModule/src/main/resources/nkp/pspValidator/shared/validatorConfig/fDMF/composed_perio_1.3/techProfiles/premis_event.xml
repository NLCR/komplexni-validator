<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<metadataProfile
        xmlns="http://www.nkp.cz/pspValidator/3.0/metadataProfile"
        name="PREMIS Event"
        dmf="composed_perio_1.3"
>

    <info>
        <text>
            Profil pro validaci PREMIS Event záznamu ve vedlejším METSu (amd_mets) pro DMF Elektronické publikace (skládaná
            periodika) 1.3 (kap. 5.5.3, s. 87). DMF nemá u elementů povinnosti ("všechny elementy jsou povinné, pokud je
            možné je vyplnit"), povinné jsou proto jen identifikace, typ, datum a odkazy na agenta a objekt.
        </text>
        <url description="popis formátu PREMIS">http://www.loc.gov/standards/premis/</url>
        <url description="XSD pro PREMIS 2.2">http://www.loc.gov/standards/premis/v2/premis-v2-2.xsd</url>
    </info>

    <namespaces>
        <namespace prefix="mets">http://www.loc.gov/METS/</namespace>
        <namespace prefix="premis">info:lc/xmlns/premis-v2</namespace>
        <namespace prefix="xsi">http://www.w3.org/2001/XMLSchema-instance</namespace>
    </namespaces>

    <rootElement name="mets:digiprovMD">
        <expectedAttributes>
            <attribute name="ID">
                <expectedContent>
                    <regexp>EVT_[0-9]{3}</regexp>
                </expectedContent>
            </attribute>
        </expectedAttributes>

        <expectedElements>
            <element name="mets:mdWrap">
                <expectedAttributes>
                    <attribute name="MDTYPE">
                        <expectedContent>
                            <value>PREMIS</value>
                        </expectedContent>
                    </attribute>

                    <attribute name="MIMETYPE">
                        <expectedContent>
                            <value>text/xml</value>
                        </expectedContent>
                    </attribute>
                </expectedAttributes>

                <expectedElements>
                    <element name="mets:xmlData">
                        <expectedElements>
                            <element name="premis:event" mandatory="true" repeatable="false">
                                <expectedElements>
                                    <element name="premis:eventIdentifier" mandatory="true" repeatable="false">
                                        <expectedElements>
                                            <element name="premis:eventIdentifierType" mandatory="true"
                                                     repeatable="false">
                                                <expectedContent/>
                                            </element>

                                            <element name="premis:eventIdentifierValue" mandatory="true"
                                                     repeatable="false">
                                                <expectedContent/>
                                            </element>
                                        </expectedElements>
                                    </element>

                                    <!--kap. 5.5.3, s. 87: hodnoty jen příkladem ("validation", "virus check", "SIP creation",
                                    "E-born creation"); ve variantě B (doskeny jako obrazy) i hodnoty pro obrazy (capture,
                                    migration, derivation, deletion), proto bez výčtu-->
                                    <element name="premis:eventType" mandatory="true" repeatable="false">
                                        <expectedContent/>
                                    </element>
                                    <element name="premis:eventDateTime" mandatory="true" repeatable="false">
                                        <expectedContent>
                                            <!--TODO: mozna regulernim vyrazem, resp. skupinou, protoze ten zapis muze byt dost ruzny - uz jenom oddelovace, viz. treba
                                                http://www.pelagodesign.com/blog/2009/05/20/iso-8601-date-validation-that-doesnt-suck/
                                            -->
                                        </expectedContent>
                                    </element>

                                    <element name="premis:eventDetail" mandatory="false" repeatable="false">
                                        <expectedContent/>
                                    </element>
                                    <element name="premis:eventOutcomeInformation" mandatory="false" repeatable="true">
                                        <expectedElements>
                                            <element name="premis:eventOutcome" mandatory="true" repeatable="false">
                                                <!--kap. 5.5.3, s. 87: povolené hodnoty "successful" nebo "failure"-->
                                                <expectedContent>
                                                    <oneOf>
                                                        <value>successful</value>
                                                        <value>failure</value>
                                                    </oneOf>
                                                </expectedContent>
                                            </element>
                                            <!--kap. 5.5.3, s. 87: pro případnou událost validace výpis výsledku-->
                                            <element name="premis:eventOutcomeDetail" mandatory="false" repeatable="true">
                                                <expectedElements>
                                                    <element name="premis:eventOutcomeDetailNote" mandatory="false" repeatable="false">
                                                        <expectedContent/>
                                                    </element>
                                                    <element name="premis:eventOutcomeDetailExtension" mandatory="false" repeatable="true"
                                                             ignoreUnexpectedChildElements="true"/>
                                                </expectedElements>
                                            </element>
                                        </expectedElements>
                                    </element>
                                    <!--Neni jasna povinnost - konflikt povinnost=M a vyskyt=0-n. UPDATE z NK: má být povinné, opraveno na povinné-->
                                    <element name="premis:linkingAgentIdentifier" mandatory="true" repeatable="true">
                                        <expectedElements>
                                            <element name="premis:linkingAgentIdentifierType" mandatory="true"
                                                     repeatable="false">
                                                <expectedContent/>
                                            </element>

                                            <element name="premis:linkingAgentIdentifierValue" mandatory="true"
                                                     repeatable="false">
                                                <expectedContent/>
                                            </element>

                                            <element name="premis:linkingAgentRole" mandatory="false" repeatable="true">
                                                <expectedContent/>
                                            </element>
                                        </expectedElements>
                                    </element>

                                    <!--Neni jasna povinnost - konflikt povinnost=M a vyskyt=0-n. UPDATE z NK: má být povinné, opraveno na povinné-->
                                    <element name="premis:linkingObjectIdentifier" mandatory="true" repeatable="true">
                                        <expectedElements>
                                            <element name="premis:linkingObjectIdentifierType" mandatory="true"
                                                     repeatable="false">
                                                <expectedContent/>
                                            </element>

                                            <element name="premis:linkingObjectIdentifierValue" mandatory="true"
                                                     repeatable="false">
                                                <expectedContent/>
                                            </element>
                                        </expectedElements>
                                    </element>
                                </expectedElements>
                            </element>
                        </expectedElements>
                    </element>
                </expectedElements>
            </element>
        </expectedElements>
    </rootElement>

</metadataProfile>
