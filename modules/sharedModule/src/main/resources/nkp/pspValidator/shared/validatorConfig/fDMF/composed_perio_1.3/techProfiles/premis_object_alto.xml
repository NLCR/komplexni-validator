<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<metadataProfile
        xmlns="http://www.nkp.cz/pspValidator/3.0/metadataProfile"
        name="PREMIS Object pro ALTO (OCR stránky doskenu)"
        dmf="composed_perio_1.3"
>

    <info>
        <text>
            Profil pro validaci PREMIS Object záznamu souboru ALTO XML (složka alto) stránky doskenu ve vedlejším METSu (amd_mets)
            pro DMF Elektronické publikace (skládaná periodika) 1.3, varianta B (doskeny zpracované jako obrazy): kap. 5.5.1,
            s. 67–73 ("záznam PREMIS Object se bude vytvářet pro každý archivní soubor, tj. soubor uložený ve složce original
            a soubory uložené ve složkách mastercopy a alto"). Odvozeno z premis_object_oc.xml (stejná tabulka DMF).
        </text>
        <url description="popis formátu PREMIS">http://www.loc.gov/standards/premis/</url>
        <url description="XSD pro PREMIS 2.2">http://www.loc.gov/standards/premis/v2/premis-v2-2.xsd</url>
    </info>

    <namespaces>
        <namespace prefix="mets">http://www.loc.gov/METS/</namespace>
        <namespace prefix="premis">info:lc/xmlns/premis-v2</namespace>
        <namespace prefix="xsi">http://www.w3.org/2001/XMLSchema-instance</namespace>
    </namespaces>

    <!--Povinnosti podle tabulky DMF kap. 5.5.1, s. 67–73: M = mandatory="true", MA a R = mandatory="false"
    (MA je povinné, pokud je údaj dostupný, to profil nerozliší).-->
    <rootElement name="mets:techMD">
        <expectedAttributes>
            <attribute name="ID">
                <expectedContent>
                    <!--kap. 5.5, s. 65: OBJ_001, OBJ_002, ..., pořadí není vázáno na formát-->
                    <regexp>OBJ_[0-9]{3}</regexp>
                </expectedContent>
            </attribute>
        </expectedAttributes>

        <expectedElements>
            <element name="mets:mdWrap">
                <expectedAttributes>
                    <attribute name="MDTYPE">
                        <expectedContent>
                            <value>PREMIS</value>
                        </expectedContent>
                    </attribute>
                    <attribute name="MIMETYPE" mandatory="false">
                        <recommendedContent>
                            <value>text/xml</value>
                        </recommendedContent>
                    </attribute>
                </expectedAttributes>

                <expectedElements>
                    <element name="mets:xmlData">
                        <expectedElements>
                            <element name="premis:object" mandatory="true" repeatable="false">
                                <expectedAttributes>
                                    <attribute name="xsi:type">
                                        <expectedContent>
                                            <oneOf>
                                                <value>file</value>
                                                <!--hodnota premis:file odpovídá XSD (xsi:type s prefixem), v praxi se používá-->
                                                <value>premis:file</value>
                                            </oneOf>
                                        </expectedContent>
                                    </attribute>
                                </expectedAttributes>
                                <expectedElements>
                                    <element name="premis:objectIdentifier" mandatory="true" repeatable="true">
                                        <expectedElements>
                                            <element name="premis:objectIdentifierType" mandatory="true" repeatable="false">
                                                <expectedContent/>
                                            </element>
                                            <element name="premis:objectIdentifierValue" mandatory="true" repeatable="false">
                                                <expectedContent/>
                                            </element>
                                        </expectedElements>
                                    </element>

                                    <element name="premis:preservationLevel" mandatory="true" repeatable="true">
                                        <expectedElements>
                                            <element name="premis:preservationLevelValue" mandatory="true" repeatable="false">
                                                <expectedContent>
                                                    <!--kap. 5.5.1, s. 67: pro archivní soubory předepsaná hodnota-->
                                                    <value>logical preservation</value>
                                                </expectedContent>
                                            </element>
                                            <element name="premis:preservationLevelDateAssigned" mandatory="false" repeatable="false">
                                                <expectedContent>
                                                    <!--ISO 8601 na úroveň dne (RRRR-MM-DD); i s časem kvůli praxi-->
                                                    <oneOf>
                                                        <regexp>[0-9]{4}-[0-9]{2}-[0-9]{2}</regexp>
                                                        <regexp>[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}</regexp>
                                                    </oneOf>
                                                </expectedContent>
                                            </element>
                                        </expectedElements>
                                    </element>

                                    <element name="premis:objectCharacteristics" mandatory="true" repeatable="true">
                                        <expectedElements>
                                            <element name="premis:compositionLevel" mandatory="true" repeatable="false">
                                                <recommendedContent>
                                                    <!--pro PDF, EPUB, TIFF a JPEG 2000 hodnota 0-->
                                                    <value>0</value>
                                                </recommendedContent>
                                            </element>

                                            <element name="premis:fixity" mandatory="true" repeatable="true">
                                                <expectedElements>
                                                    <element name="premis:messageDigestAlgorithm" mandatory="true" repeatable="false">
                                                        <expectedContent/>
                                                    </element>
                                                    <element name="premis:messageDigest" mandatory="true" repeatable="false">
                                                        <expectedContent/>
                                                    </element>
                                                    <element name="premis:messageDigestOriginator" mandatory="true" repeatable="false">
                                                        <expectedContent/>
                                                    </element>
                                                </expectedElements>
                                            </element>

                                            <element name="premis:size" mandatory="true" repeatable="false">
                                                <expectedContent>
                                                    <regexp>[0-9]+</regexp>
                                                </expectedContent>
                                            </element>

                                            <element name="premis:format" mandatory="true" repeatable="true">
                                                <expectedElements>
                                                    <element name="premis:formatDesignation" mandatory="true" repeatable="false">
                                                        <expectedElements>
                                                            <element name="premis:formatName" mandatory="true" repeatable="false">
                                                                <!--kap. 5.5.1, s. 68: "uvede se MIMETYPE"; ALTO XML má v fileSec MIMETYPE text/xml (kap. 5.6.2, s. 91)-->
                                                                <expectedContent>
                                                                    <regexp>^text/xml$</regexp>
                                                                </expectedContent>
                                                            </element>
                                                            <element name="premis:formatVersion" mandatory="true" repeatable="false">
                                                                <expectedContent/>
                                                            </element>
                                                        </expectedElements>
                                                    </element>
                                                    <element name="premis:formatRegistry" mandatory="true" repeatable="false">
                                                        <expectedElements>
                                                            <element name="premis:formatRegistryName" mandatory="true" repeatable="false">
                                                                <expectedContent>
                                                                    <value>PRONOM</value>
                                                                </expectedContent>
                                                            </element>
                                                            <element name="premis:formatRegistryKey" mandatory="true" repeatable="false">
                                                                <expectedContent/>
                                                            </element>
                                                        </expectedElements>
                                                    </element>
                                                </expectedElements>
                                            </element>

                                            <element name="premis:creatingApplication" mandatory="false" repeatable="true">
                                                <expectedElements>
                                                    <element name="premis:creatingApplicationName" mandatory="true" repeatable="false">
                                                        <expectedContent/>
                                                    </element>
                                                    <element name="premis:creatingApplicationVersion" mandatory="false" repeatable="false">
                                                        <expectedContent/>
                                                    </element>
                                                    <element name="premis:dateCreatedByApplication" mandatory="false" repeatable="false">
                                                        <expectedContent/>
                                                    </element>
                                                </expectedElements>
                                            </element>

                                            <!--kap. 5.5.1, s. 69 a 71: objectCharacteristicsExtension (docmd, ndktech) DMF předepisuje jen pro PDF/A
                                            a EPUB, u JPEG 2000 a ALTO ho neuvádí; obsah se nekontroluje-->
                                            <element name="premis:objectCharacteristicsExtension" mandatory="false" repeatable="true"
                                                     ignoreUnexpectedChildElements="true"/>
                                        </expectedElements>
                                    </element>

                                    <element name="premis:originalName" mandatory="false" repeatable="false">
                                        <expectedContent/>
                                    </element>

                                    <element name="premis:relationship" mandatory="false" repeatable="true">
                                        <expectedElements>
                                            <element name="premis:relationshipType" mandatory="true" repeatable="false">
                                                <recommendedContent>
                                                    <oneOf>
                                                        <value>derivation</value>
                                                        <value>structural</value>
                                                    </oneOf>
                                                </recommendedContent>
                                            </element>
                                            <element name="premis:relationshipSubType" mandatory="true" repeatable="false">
                                                <recommendedContent>
                                                    <oneOf>
                                                        <value>created from</value>
                                                        <value>has source</value>
                                                        <value>is source of</value>
                                                        <value>has sibling</value>
                                                        <value>has part</value>
                                                        <value>is part of</value>
                                                        <value>has root</value>
                                                        <value>includes</value>
                                                        <value>is included in</value>
                                                    </oneOf>
                                                </recommendedContent>
                                            </element>
                                            <element name="premis:relatedObjectIdentification" mandatory="true" repeatable="true">
                                                <expectedElements>
                                                    <element name="premis:relatedObjectIdentifierType" mandatory="true" repeatable="false">
                                                        <expectedContent/>
                                                    </element>
                                                    <element name="premis:relatedObjectIdentifierValue" mandatory="true" repeatable="false">
                                                        <expectedContent/>
                                                    </element>
                                                    <element name="premis:relatedObjectSequence" mandatory="false" repeatable="false">
                                                        <expectedContent/>
                                                    </element>
                                                </expectedElements>
                                            </element>
                                            <element name="premis:relatedEventIdentification" mandatory="false" repeatable="true">
                                                <expectedElements>
                                                    <element name="premis:relatedEventIdentifierType" mandatory="true" repeatable="false">
                                                        <expectedContent/>
                                                    </element>
                                                    <element name="premis:relatedEventIdentifierValue" mandatory="true" repeatable="false">
                                                        <expectedContent/>
                                                    </element>
                                                    <element name="premis:relatedEventSequence" mandatory="false" repeatable="false">
                                                        <expectedContent/>
                                                    </element>
                                                </expectedElements>
                                            </element>
                                        </expectedElements>
                                    </element>

                                    <element name="premis:linkingEventIdentifier" mandatory="false" repeatable="true">
                                        <expectedElements>
                                            <element name="premis:linkingEventIdentifierType" mandatory="true" repeatable="false">
                                                <expectedContent/>
                                            </element>
                                            <element name="premis:linkingEventIdentifierValue" mandatory="true" repeatable="false">
                                                <expectedContent/>
                                            </element>
                                        </expectedElements>
                                    </element>
                                </expectedElements>
                            </element>
                        </expectedElements>
                    </element>
                </expectedElements>
            </element>
        </expectedElements>
    </rootElement>

</metadataProfile>
