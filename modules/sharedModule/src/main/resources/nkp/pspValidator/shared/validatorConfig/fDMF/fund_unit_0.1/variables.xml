    <value-def name="IE_IDENTIFIERS" type="IDENTIFIER_LIST">
        <description>seznam identifikátorů intelektuální entity (UNIT) ze souboru PRIMARY-METS</description>
        <!--Funkce getIeIdentifiersFromPrimaryMetsFile má prefixy IE zadrátované (ISSUE/SUPPL/VOLUME), proto se IE vybírá
        datově podle dmdSec ID, stejně jako u monografií.-->
        <evaluation functionName="selectIeIdentifiersFromPrimaryMetsFile">
            <params>
                <value name="mets_identifier_list_list" type="IDENTIFIER_LIST_LIST">
                    <!--seznam obsahujici seznam identifikatoru pro kazdy zaznam dmdSec pro MODS-->
                    <evaluation functionName="getModsIdentifiersForEachDmdsecId">
                        <params>
                            <value name="dmdsec_ids" type="STRING_LIST">
                                <!--seznam identifikatoru (dmdSec ID); podtrzitko na konci je nutne, jinak by odpovidalo i UNITCOLLECTION-->
                                <evaluation functionName="getStringListByXpath">
                                    <params>
                                        <value name="xml_file" type="FILE">
                                            <value-ref name="PRIMARY-METS_FILE"/>
                                        </value>
                                        <value name="xpath" type="STRING">
                                            /mets:mets/mets:dmdSec[starts-with(@ID, "MODSMD_UNIT_")]/@ID
                                        </value>
                                    </params>
                                </evaluation>
                            </value>
                            <value name="mets_file" type="FILE">
                                <value-ref name="PRIMARY-METS_FILE"/>
                            </value>
                        </params>
                    </evaluation>
                </value>
            </params>
        </evaluation>
    </value-def>

