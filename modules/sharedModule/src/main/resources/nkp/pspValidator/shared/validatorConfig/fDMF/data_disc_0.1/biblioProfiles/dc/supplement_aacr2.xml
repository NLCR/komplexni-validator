<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<metadataProfile
        xmlns="http://www.nkp.cz/pspValidator/2.7/metadataProfile"
        name="DC supplement (AACR2)"
        validatorVersion="2.7"
        dmf="data_disc_0.1"
>

    <info>
        <text>
            DMF Datové disky 0.1 očekává Dublin Core verze 1.1.
            Dále se zde upřesňují očekávaná metadata pro přílohu pro záznamy zpracované podle katalogizačních
            pravidel AACR2.
        </text>
        <url description="popis Dublin Core 1.1">http://dublincore.org/documents/dces/</url>
        <url description="XSD pro Dublin Core 1.1">http://www.openarchives.org/OAI/2.0/oai_dc.xsd</url>
    </info>

    <namespaces>
        <namespace prefix="oai_dc">http://www.openarchives.org/OAI/2.0/oai_dc/</namespace>
        <namespace prefix="dc">http://purl.org/dc/elements/1.1/</namespace>
    </namespaces>

    <dictionaries>
        <dictionary name="iso6392languageCodes"
                    description="kódy jazyků podle ISO 639-2"
                    url="http://www.loc.gov/standards/iso639-2/php/code_list.php"/>
    </dictionaries>

    <rootElement name="oai_dc:dc">
        <expectedElements>

            <element name="dc:title" mandatory="false">
                <!--mods:titleInfo/mods:title or mods:titleInfo/mods:subTitle-->
                <expectedContent/>
            </element>

            <element name="dc:description" mandatory="false">
                <!--mods:titleInfo/mods:partNumber or mods:titleInfo/mods:partName or mods:note -->
                <expectedContent/>
            </element>

            <element name="dc:creator" mandatory="false">
                <!--mods:name/mods:namePart  or mods:name/mods:nameIdentifier-->
                <expectedContent/>
            </element>

            <element name="dc:type" specification="text() = 'model:supplement'"
                     errorMessage="Očekáván povinný element dc:type obsahující text 'model:supplement'.">
                <expectedContent/>
            </element>

            <element name="dc:language" mandatory="false">
                <!--mods:language/mods:languageTerm -->
                <expectedContent/>
            </element>

            <element name="dc:format"
                     errorMessage="Očekáván povinný element dc:format obsahující informace o počtu skenů přílohy.">
                <expectedContent/>
            </element>

            <element name="dc:identifier" errorMessage="Očekáván alespoň jeden povinný element dc:identifier.">
                <expectedContent/>
            </element>

        </expectedElements>
    </rootElement>

</metadataProfile>

	
