            <!--konspekt-->
            <element name="mods:classification" mandatory="false" specification="@authority='konspekt'">
                <expectedAttributes>
                    <attribute name="authority">
                        <expectedContent>
                            <oneOf>
                                <value>Konspekt</value>
                            </oneOf>
                        </expectedContent>
                    </attribute>

                    <attribute name="edition" mandatory="true">
                        <expectedContent>
                            <value>Konspekt</value>
                        </expectedContent>
                    </attribute>
                </expectedAttributes>
                <expectedContent/>
            </element>

            <!--mezinarodni desetinne trideni-->
            <element name="mods:classification" mandatory="false" specification="@authority='udc'">
                <expectedAttributes>
                    <attribute name="authority">
                        <expectedContent>
                            <oneOf>
                                <value>udc</value>
                            </oneOf>
                        </expectedContent>
                    </attribute>
                </expectedAttributes>
                <expectedContent/>
