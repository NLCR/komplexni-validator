                </expectedAttributes>

                <expectedElements>
                    <element name="mods:topic" mandatory="true">
                        <expectedContent>
                            <!--V DMF je "použít kontrolovaný slovník, například ... " - tj. kontrolovaný slovník NENÍ vyžadován DMF-->
                        </expectedContent>
