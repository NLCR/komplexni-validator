                            <attribute name="encoding" mandatory="false">
                                <!--<recommendedContent>
                                    <value>marc</value>
                                </recommendedContent>-->
                            </attribute>
                            <attribute name="point" mandatory="false">
                                <!--<recommendedContent>
                                    <oneOf>
                                        <value>start</value>
                                        <value>end</value>
                                    </oneOf>
                                </recommendedContent>-->
                            </attribute>
                            <attribute name="qualifier" mandatory="false">
                                <!--<recommendedContent>
                                    <value>approximate</value>
                                </recommendedContent>-->
                            </attribute>
                        </expectedAttributes>
                        <expectedContent/>
                    </element>

                    <element name="mods:issuance" mandatory="true">
                        <expectedContent>
                            <oneOf>
                                <value>monographic</value>
                                <value>serial</value>
                                <value>integrating resource</value>
                            </oneOf>
                        </expectedContent>
                    </element>
                </expectedElements>
            </element>

            <element name="mods:physicalDescription" mandatory="false">
                <expectedElements>
                    <element name="mods:form">
                        <expectedAttributes>
                            <attribute name="authority" mandatory="false"/>
                            <attribute name="type" mandatory="false"/>
                        </expectedAttributes>
                        <expectedContent/>
                    </element>

                    <element name="mods:extent" mandatory="true">
