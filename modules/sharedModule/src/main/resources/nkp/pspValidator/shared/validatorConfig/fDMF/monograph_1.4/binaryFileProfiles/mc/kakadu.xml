<binaryFileProfile
        xmlns="http://www.nkp.cz/pspValidator/3.0/binaryFileProfile"
        dmf="monograph_1.4"
>
    <fromText>

        <validation name="no_errors">
            <textDataExtraction resultType="STRING_LIST">
                <allNonempty>
                    <regexp>(?ms)Kakadu Core Error:((?!Kakadu Core Error).)*</regexp>
                </allNonempty>
            </textDataExtraction>
            <rules>
                <mustNotExist/>
            </rules>
        </validation>

        <!-- soubor, který kdu_expand nemůže otevřít, nevypíše Kakadu Core Error, ale Error in Kakadu File Format Support:
             Unable to open input file; chyba je vždy ERROR, soubor se nezkontroloval -->
        <validation name="soubor nelze otevřít (neexistuje, není čitelný, nebo na Windows cesta obsahuje znak mimo znakovou sadu systému)">
            <textDataExtraction resultType="STRING_LIST">
                <allNonempty>
                    <regexp>(?ms)Error in Kakadu File Format Support:\s*Unable to open input file((?!Kakadu Core Error|Error in Kakadu).)*</regexp>
                </allNonempty>
            </textDataExtraction>
            <rules>
                <mustNotExist level="ERROR"/>
            </rules>
        </validation>

        <!-- ostatní chyby mimo jádro Kakadu (Error in Kakadu File Format Support, Error in Kakadu Compressed I/O Support,
             Kakadu Error), např. JP2 bez kódového proudu („JPX data source appears to contain no codestreams at all“);
             soubor se nezkontroloval, chyba je vždy ERROR; „Unable to open input file“ hlásí validace výše -->
        <validation name="chyba Kakadu při čtení souboru (soubor se nezkontroloval)">
            <textDataExtraction resultType="STRING_LIST">
                <allNonempty>
                    <regexp>(?ms)(?:Error in Kakadu(?! File Format Support:\s*Unable to open input file)|Kakadu Error:)((?!Kakadu Core Error|Error in Kakadu|Kakadu Error:).)*</regexp>
                </allNonempty>
            </textDataExtraction>
            <rules>
                <mustNotExist level="ERROR"/>
            </rules>
        </validation>

    </fromText>
</binaryFileProfile>