<binaryFileProfile
        xmlns="http://www.nkp.cz/pspValidator/3.0/binaryFileProfile"
        validatorVersion="3.0"
        dmf="emonograph_2.4"
>

    <fromXml>
        <namespaces>
            <!--<defaultNamespace>http://schema.openpreservation.org/ois/xml/ns/jhove</defaultNamespace>-->
            <namespace prefix="j">http://schema.openpreservation.org/ois/xml/ns/jhove</namespace>
        </namespaces>

        <validation name="Soubor musí být validní">
            <xmlDataExtraction resultType="STRING">
                <firstNonempty>
                    <xpath>//j:repInfo/j:status</xpath>
                </firstNonempty>
            </xmlDataExtraction>
            <rules>
                <mustExist/>
                <mustMatchAny>
                    <isExactly>Well-formed</isExactly>
                </mustMatchAny>
            </rules>
        </validation>

        <validation name="Soubor Epub by měl být v podporované verzi">
            <xmlDataExtraction resultType="STRING">
                <firstNonempty>
                    <xpath>//j:repInfo/j:version</xpath>
                </firstNonempty>
            </xmlDataExtraction>
            <rules>
                <mustExist/>
                <mustMatchAny level="WARNING">
                    <isExactly>2.0.1</isExactly>
                </mustMatchAny>
            </rules>
        </validation>

        <!--EPUBCheck 5.x hlásí RSC-004 (šifrovaný obsah) jen jako INFO a do XML výstupu ho nevypíše, takže tato
            validace s aktuálními verzemi nic nenajde. Validace zůstává beze změny (port z VEP), čeká na dotaz NK,
            zda a jak DRM kontrolovat.-->
        <validation name="Kontrola na přítomnost DRM">
            <xmlDataExtraction resultType="STRING_LIST">
                <allNonempty>
                    <xpath>//j:repInfo/j:messages/j:message[@id='RSC-004']</xpath>
                </allNonempty>
            </xmlDataExtraction>
            <rules>
                <mustNotExist level="ERROR"/>
            </rules>
        </validation>

        <!--TODO: chybová hláška "Obsahuje vlastnost problematickou z hlediska dlouhodobého uchovávání" -->
        <validation name="Kontrola typů obsažených objektů (Epub 2)">
            <xmlDataExtraction resultType="STRING_LIST">
                <allNonempty>
                    <xpath>//j:repInfo/j:version[starts-with(text(),'2.')]/..//j:property/j:name[text()='MediaTypes']/../j:values/j:value</xpath>
                </allNonempty>
            </xmlDataExtraction>
            <rules>
                <!--core media types podle OPS 2.0.1 kap. 1.3.7 (seznam z VEP 2.4 doplněný o DTBook a OEB 1.x);
                    fonty nejsou v EPUB 2 core media types, proto dávají WARNING (např. application/vnd.ms-opentype)-->
                <mustMatchAny level="WARNING">
                    <isExactly>text/css</isExactly>

                    <isExactly>image/gif</isExactly>
                    <isExactly>image/jpeg</isExactly>
                    <isExactly>image/png</isExactly>
                    <isExactly>image/svg+xml</isExactly>

                    <isExactly>application/xhtml+xml</isExactly>
                    <isExactly>application/x-dtbook+xml</isExactly>
                    <isExactly>application/xml</isExactly>
                    <isExactly>application/x-dtbncx+xml</isExactly>
                    <isExactly>text/x-oeb1-document</isExactly>
                    <isExactly>text/x-oeb1-css</isExactly>

                    <!--známé nepovolené hodnoty-->
                    <!--<isExactly>application/vnd.ms-opentype</isExactly>-->
                    <!--<isExactly>application/vnd.adobe-page-template+xml</isExactly>-->
                </mustMatchAny>
            </rules>
        </validation>

        <validation name="Kontrola typů obsažených objektů (Epub 3)">
            <xmlDataExtraction resultType="STRING_LIST">
                <allNonempty>
                    <xpath>//j:repInfo/j:version[starts-with(text(),'3.')]/..//j:property/j:name[text()='MediaTypes']/../j:values/j:value</xpath>
                </allNonempty>
            </xmlDataExtraction>
            <rules>
                <!--core media types podle EPUB 3.3 kap. 3.2 (W3C 2023); VEP 2.4 měl seznam z r. 2021 s překlepem
                    "application/font-wof" (s pomlčkou U+2010 místo spojovníku), takže každý WOFF font dával WARNING. application/xml ponechán z VEP.
                    Typy mimo seznam (video, AVIF a JPEG XL z EPUB 3.4, ...) dávají WARNING; revize s NK (A4 R3)-->
                <mustMatchAny level="WARNING">
                    <isExactly>text/css</isExactly>

                    <isExactly>image/gif</isExactly>
                    <isExactly>image/jpeg</isExactly>
                    <isExactly>image/png</isExactly>
                    <isExactly>image/svg+xml</isExactly>
                    <isExactly>image/webp</isExactly>

                    <isExactly>application/xhtml+xml</isExactly>
                    <isExactly>application/xml</isExactly>
                    <isExactly>application/x-dtbncx+xml</isExactly>
                    <isExactly>application/smil+xml</isExactly>
                    <isExactly>application/pls+xml</isExactly>
                    <isExactly>application/javascript</isExactly>
                    <isExactly>text/javascript</isExactly>
                    <isExactly>application/ecmascript</isExactly>

                    <isExactly>font/ttf</isExactly>
                    <isExactly>application/font-sfnt</isExactly>
                    <isExactly>font/otf</isExactly>
                    <isExactly>application/vnd.ms-opentype</isExactly>
                    <isExactly>font/woff</isExactly>
                    <isExactly>application/font-woff</isExactly>
                    <isExactly>font/woff2</isExactly>

                    <isExactly>audio/mpeg</isExactly>
                    <isExactly>audio/mp4</isExactly>
                    <!--jen Ogg s kodekem Opus; obecné audio/ogg (např. Vorbis) core media type není-->
                    <isExactly>audio/ogg; codecs=opus</isExactly>
                </mustMatchAny>
            </rules>
        </validation>

        <validation name="Detekce chybových hlášek">
            <xmlDataExtraction resultType="STRING_LIST">
                <allNonempty>
                    <xpath>//j:repInfo/j:messages/j:message</xpath>
                </allNonempty>
            </xmlDataExtraction>
            <rules>
                <mustNotExist level="WARNING"/>
            </rules>
        </validation>

    </fromXml>
</binaryFileProfile>