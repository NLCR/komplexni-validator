<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<metadataProfile
        xmlns="http://www.nkp.cz/pspValidator/3.0/metadataProfile"
        name="MIX MC (archivní kopie)"
        validatorVersion="3.0"
        dmf="composed_perio_1.3"
>

    <info>
        <text>
            Profil pro validaci MIX záznamu archivní kopie (MC) stránky doskenu ve vedlejším METSu (amd_mets) pro DMF Elektronické
            publikace (skládaná periodika) 1.3, varianta B (doskeny zpracované jako obrazy): kap. 5.5.2, s. 78–86, sloupec
            "Použití pro" MC. Povinnosti: M = mandatory="true", MA, R a O = mandatory="false" (MA profil nerozliší).
            Výchozí stav převzat z fund_unit_0.2 (názvy elementů podle mix_2.0.xsd: iccProfileURI, TargetID, performanceData).
        </text>
        <url description="popis formátu MIX">http://www.loc.gov/standards/mix/</url>
        <url description="XSD pro MIX 2.0">http://www.loc.gov/standards/mix/mix.xsd</url>
    </info>

    <namespaces>
        <namespace prefix="mets">http://www.loc.gov/METS/</namespace>
        <namespace prefix="mix">http://www.loc.gov/mix/v20</namespace>
    </namespaces>

    <rootElement name="mets:techMD">
        <expectedAttributes>
            <!--ID techMD pro MIX DMF Skládaná e-periodika 1.3 neuvádí (kap. 5.5, s. 65 jen OBJ_, EVT_, AGENT_); MIX_XXX je konvence
            DMF Periodika a KV kontroluje XSD MIX (MIX_VALID_BY_XSD) jen u techMD s ID začínajícím MIX_, proto doporučená hodnota-->
            <attribute name="ID">
                <recommendedContent>
                    <regexp>MIX_[0-9]{3}</regexp>
                </recommendedContent>
            </attribute>
        </expectedAttributes>

        <expectedElements>
            <element name="mets:mdWrap">
                <expectedAttributes>
                    <attribute name="MDTYPE">
                        <expectedContent>
                            <value>NISOIMG</value>
                        </expectedContent>
                    </attribute>

                    <attribute name="MIMETYPE">
                        <expectedContent>
                            <value>text/xml</value>
                        </expectedContent>
                    </attribute>
                </expectedAttributes>

                <expectedElements>
                    <element name="mets:xmlData">
                        <expectedElements>
                            <element name="mix:mix">
                                <expectedElements>
                                    <element name="mix:BasicDigitalObjectInformation">
                                        <expectedElements>
                                            <element name="mix:ObjectIdentifier" mandatory="false" repeatable="true">
                                                <expectedElements>
                                                    <element name="mix:objectIdentifierType" mandatory="true" repeatable="false">
                                                        <expectedContent/>
                                                    </element>

                                                    <element name="mix:objectIdentifierValue" mandatory="true" repeatable="false">
                                                        <expectedContent/>
                                                    </element>
                                                </expectedElements>
                                            </element>

                                            <element name="mix:fileSize" mandatory="false" repeatable="false">
                                                <expectedContent/>
                                            </element>

                                            <element name="mix:FormatDesignation" mandatory="true" repeatable="false">
                                                <expectedElements>
                                                    <element name="mix:formatName" mandatory="true" repeatable="false">
                                                        <!--DMF Skládaná e-periodika 1.3, kap. 5.5.2, s. 78: "např. lze využít MIME types (image/jp2
                                                        apod.)", tedy MIME jen doporučený (změnový list 1.3 opravil příklad Image/jp2 na image/jp2)-->
                                                        <recommendedContent>
                                                            <regexp>^(image|text)/[A-Za-z0-9][A-Za-z0-9!#$&amp;^_.+-]*$</regexp>
                                                        </recommendedContent>
                                                    </element>

                                                    <element name="mix:formatVersion" mandatory="true" repeatable="false">
                                                        <expectedContent/>
                                                    </element>
                                                </expectedElements>
                                            </element>

                                            <element name="mix:byteOrder" mandatory="true" repeatable="false">
                                                <expectedContent>
                                                    <!--kap. 5.5.2, s. 78: "little endian" a "big endian"; hodnotu "middle (mix) endian" změnový list 1.3
                                                    odstranil (standard MIX ji nepředepisuje)-->
                                                    <oneOf>
                                                        <value>little endian</value>
                                                        <value>big endian</value>
                                                    </oneOf>
                                                </expectedContent>
                                            </element>

                                            <element name="mix:Compression" mandatory="true" repeatable="true">
                                                <expectedElements>
                                                    <element name="mix:compressionScheme" mandatory="true" repeatable="false">
                                                        <expectedContent/>
                                                    </element>
                                                </expectedElements>
                                            </element>
                                        </expectedElements>
                                    </element>

                                    <element name="mix:BasicImageInformation" mandatory="true" repeatable="false">
                                        <expectedElements>
                                            <element name="mix:BasicImageCharacteristics" mandatory="true" repeatable="false">
                                                <expectedElements>
                                                    <element name="mix:imageWidth" mandatory="true" repeatable="false">
                                                        <expectedContent>
                                                            <regexp>[0-9]+</regexp>
                                                        </expectedContent>
                                                    </element>

                                                    <element name="mix:imageHeight" mandatory="true" repeatable="false">
                                                        <expectedContent>
                                                            <regexp>[0-9]+</regexp>
                                                        </expectedContent>
                                                    </element>

                                                    <element name="mix:PhotometricInterpretation" mandatory="true" repeatable="false">
                                                        <expectedElements>
                                                            <element name="mix:colorSpace" mandatory="true" repeatable="false">
                                                                <expectedContent/>
                                                            </element>

                                                            <element name="mix:ColorProfile" mandatory="false" repeatable="false">
                                                                <expectedElements>
                                                                    <element name="mix:IccProfile" mandatory="true" repeatable="false">
                                                                        <expectedElements>
                                                                            <element name="mix:iccProfileName" mandatory="true" repeatable="false">
                                                                                <expectedContent/>
                                                                            </element>

                                                                            <element name="mix:iccProfileVersion" mandatory="true" repeatable="false">
                                                                                <expectedContent/>
                                                                            </element>

                                                                            <element name="mix:iccProfileURI" mandatory="false" repeatable="false">
                                                                                <expectedContent/>
                                                                            </element>
                                                                        </expectedElements>

                                                                    </element>
                                                                </expectedElements>
                                                            </element>
                                                        </expectedElements>
                                                    </element>

                                                </expectedElements>
                                            </element>

                                            <!--kap. 5.5.2, s. 79: MA, "povinné použití pro formát JPEG2000"; archivní kopie má podle kap. 4
                                            (s. 12) vždy příponu .jp2, proto povinné-->
                                            <element name="mix:SpecialFormatCharacteristics" mandatory="true"
                                                     repeatable="false">
                                                <expectedElements>
                                                    <element name="mix:JPEG2000" mandatory="true" repeatable="false">
                                                        <expectedElements>
                                                            <element name="mix:CodecCompliance" mandatory="true" repeatable="false">
                                                                <expectedElements>
                                                                    <element name="mix:codec" mandatory="true" repeatable="false">
                                                                        <expectedContent/>
                                                                    </element>

                                                                    <element name="mix:codecVersion" mandatory="true" repeatable="false">
                                                                        <expectedContent/>
                                                                    </element>

                                                                    <!--kap. 5.5.2, s. 80: codestreamProfile a complianceClass R-->
                                                                    <element name="mix:codestreamProfile" mandatory="false" repeatable="false">
                                                                        <expectedContent/>
                                                                    </element>

                                                                    <element name="mix:complianceClass" mandatory="false" repeatable="false">
                                                                        <expectedContent>
                                                                            <oneOf>
                                                                                <value>C0</value>
                                                                                <value>C1</value>
                                                                                <value>C2</value>
                                                                            </oneOf>
                                                                        </expectedContent>
                                                                    </element>
                                                                </expectedElements>
                                                            </element>

                                                            <element name="mix:EncodingOptions" mandatory="true" repeatable="false">
                                                                <expectedElements>
                                                                    <element name="mix:Tiles" mandatory="true" repeatable="false">
                                                                        <expectedElements>
                                                                            <element name="mix:tileWidth" mandatory="true" repeatable="false">
                                                                                <expectedContent>
                                                                                    <regexp>[0-9]+</regexp>
                                                                                </expectedContent>
                                                                            </element>

                                                                            <element name="mix:tileHeight" mandatory="true" repeatable="false">
                                                                                <expectedContent>
                                                                                    <regexp>[0-9]+</regexp>
                                                                                </expectedContent>
                                                                            </element>
                                                                        </expectedElements>
                                                                    </element>

                                                                    <element name="mix:qualityLayers" mandatory="true" repeatable="false">
                                                                        <expectedContent>
                                                                            <regexp>[0-9]+</regexp>
                                                                        </expectedContent>
                                                                    </element>

                                                                    <element name="mix:resolutionLevels" mandatory="true" repeatable="false">
                                                                        <expectedContent>
                                                                            <regexp>[0-9]+</regexp>
                                                                        </expectedContent>
                                                                    </element>
                                                                </expectedElements>
                                                            </element>
                                                        </expectedElements>
                                                    </element>
                                                </expectedElements>
                                            </element>
                                        </expectedElements>
                                    </element>

                                    <element name="mix:ImageAssessmentMetadata" mandatory="true" repeatable="false">
                                        <expectedElements>
                                            <element name="mix:SpatialMetrics" mandatory="true" repeatable="false">
                                                <expectedElements>
                                                    <element name="mix:samplingFrequencyPlane" mandatory="false" repeatable="false">
                                                        <expectedContent/>
                                                    </element>

                                                    <element name="mix:samplingFrequencyUnit" mandatory="true" repeatable="false">
                                                        <expectedContent>
                                                            <!--TODO: Muze byt z DMF nejasne, jestli jde o jedine povolenne hodnoty, nebo priklady hodnot.-->
                                                            <oneOf>
                                                                <value>no absolute unit of measurement</value>
                                                                <value>in.</value>
                                                                <value>cm</value>
                                                            </oneOf>
                                                        </expectedContent>
                                                    </element>

                                                    <element name="mix:xSamplingFrequency" mandatory="false" repeatable="false">
                                                        <expectedElements>
                                                            <element name="mix:numerator" mandatory="true" repeatable="false">
                                                                <expectedContent>
                                                                    <regexp>[0-9]+</regexp>
                                                                </expectedContent>
                                                            </element>

                                                            <element name="mix:denominator" mandatory="true" repeatable="false">
                                                                <expectedContent>
                                                                    <regexp>[0-9]+</regexp>
                                                                </expectedContent>
                                                            </element>
                                                        </expectedElements>
                                                    </element>

                                                    <element name="mix:ySamplingFrequency" mandatory="false" repeatable="false">
                                                        <expectedElements>
                                                            <element name="mix:numerator" mandatory="true" repeatable="false">
                                                                <expectedContent>
                                                                    <regexp>[0-9]+</regexp>
                                                                </expectedContent>
                                                            </element>

                                                            <element name="mix:denominator" mandatory="true" repeatable="false">
                                                                <expectedContent>
                                                                    <regexp>[0-9]+</regexp>
                                                                </expectedContent>
                                                            </element>
                                                        </expectedElements>
                                                    </element>
                                                </expectedElements>
                                            </element>

                                            <element name="mix:ImageColorEncoding" mandatory="true" repeatable="false">
                                                <expectedElements>
                                                    <element name="mix:BitsPerSample" mandatory="true" repeatable="false">
                                                        <expectedElements>
                                                            <element name="mix:bitsPerSampleValue" mandatory="true" repeatable="true">
                                                                <expectedContent/>
                                                            </element>

                                                            <element name="mix:bitsPerSampleUnit" mandatory="false" repeatable="false">
                                                                <expectedContent/>
                                                            </element>
                                                        </expectedElements>
                                                    </element>

                                                    <element name="mix:samplesPerPixel" mandatory="true" repeatable="false">
                                                        <expectedContent>
                                                            <regexp>[0-9]+</regexp>
                                                        </expectedContent>
                                                    </element>

                                                    <element name="mix:TargetData" mandatory="false" repeatable="false">
                                                        <expectedElements>
                                                            <element name="mix:targetType" mandatory="true" repeatable="true">
                                                                <expectedContent>
                                                                    <oneOf>
                                                                        <value>0</value>
                                                                        <value>1</value>
                                                                    </oneOf>
                                                                </expectedContent>
                                                            </element>

                                                            <element name="mix:TargetID" mandatory="true" repeatable="true">
                                                                <expectedElements>
                                                                    <element name="mix:targetManufacturer" mandatory="true" repeatable="false">
                                                                        <expectedContent/>
                                                                    </element>

                                                                    <element name="mix:targetName" mandatory="true" repeatable="false">
                                                                        <expectedContent/>
                                                                    </element>

                                                                    <element name="mix:targetNo" mandatory="true" repeatable="false">
                                                                        <expectedContent/>
                                                                    </element>

                                                                    <element name="mix:targetMedia" mandatory="false" repeatable="false">
                                                                        <expectedContent/>
                                                                    </element>
                                                                </expectedElements>
                                                            </element>

                                                            <element name="mix:externalTarget" mandatory="false" repeatable="true">
                                                                <expectedContent/>
                                                            </element>

                                                            <element name="mix:performanceData" mandatory="false" repeatable="true">
                                                                <expectedContent/>
                                                            </element>
                                                        </expectedElements>
                                                    </element>
                                                </expectedElements>
                                            </element>
                                        </expectedElements>
                                    </element>

                                    <element name="mix:ChangeHistory" mandatory="true" repeatable="false">
                                        <expectedElements>
                                            <element name="mix:ImageProcessing" mandatory="true" repeatable="true">
                                                <expectedElements>
                                                    <element name="mix:dateTimeProcessed" mandatory="true" repeatable="false">
                                                        <expectedContent>
                                                            <!--TODO: iso8601-->
                                                            <!--TODO: mozna regulernim vyrazem, resp. skupinou, protoze ten zapis muze byt dost ruzny - uz jenom oddelovace, viz. treba
                                                                http://www.pelagodesign.com/blog/2009/05/20/iso-8601-date-validation-that-doesnt-suck/
                                                             -->
                                                        </expectedContent>
                                                    </element>

                                                    <element name="mix:sourceData" mandatory="true" repeatable="false">
                                                        <expectedContent/>
                                                    </element>

                                                    <element name="mix:processingAgency" mandatory="false" repeatable="true">
                                                        <expectedContent>
                                                            <!--TODO: Co to znamena "The National Library of the Czech Republic"? Ze je povolena prave a jenom tahle hodnota?-->
                                                        </expectedContent>
                                                    </element>
                                                </expectedElements>
                                            </element>
                                        </expectedElements>
                                    </element>
                                </expectedElements>
                            </element>
                        </expectedElements>
                    </element>
                </expectedElements>
            </element>
        </expectedElements>
    </rootElement>

</metadataProfile>
