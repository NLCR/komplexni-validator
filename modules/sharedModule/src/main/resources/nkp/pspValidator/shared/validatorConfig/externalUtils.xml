            <!--http://jpylyzer.openpreservation.org//installation.html-->
            <!-- <operatingSystem name="MAC">
                 <command>python ${UTIL_PATH}jpylyzer.py &#45;&#45;version</command>
                 <parser>
                     <stream>STDERR</stream>
                     <regexp>\A[0-9\.]+$</regexp>
                 </parser>
             </operatingSystem>-->

            <!--jpylyzer 2.2.0-->
            <operatingSystem name="LINUX">
                <command>${UTIL_PATH}jpylyzer --version</command>
                <parser>
                    <stream>STDOUT</stream>
                    <regexp>(?s).*</regexp>
                </parser>
            </operatingSystem>
            <operatingSystem name="WINDOWS">
                <command>${UTIL_PATH}jpylyzer.exe --version</command>
                <parser>
                    <stream>STDOUT</stream>
                    <regexp>(?s).*</regexp>
                </parser>
            </operatingSystem>
            <operatingSystem name="MAC">
                <command>${UTIL_PATH}jpylyzer --version</command>
                <parser>
                    <stream>STDOUT</stream>
                    <regexp>(?s).*</regexp>
                </parser>
            </operatingSystem>
        </versionDetection>
        <execution name="jp2k">
