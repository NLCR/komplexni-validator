<!--
    This file defines available external utils.
    Available variables are:
    ${UTIL_PATH} - in version detection and execution will be replaced by whole path to given util, if the path is set, and with empty string otherwise
    ${TARGET_FILE} - in execution will be replaced by target file, with absolute path

    verifiedVersions: ověřené řady verzí nástroje podle platformy. Verze z ověřené řady (řada 7.1 platí pro 7.1.x
    včetně 7.1.2-35, ne pro 7.10 ani 7.2) se bere jako ověřená. Jiná verze, nebo verze, kterou nejde z výstupu detekce
    rozpoznat, se označí: v protokolu jedna INFO u každého pravidla, které nástroj používá, ve výpisu nástrojů v CLI
    a ve stavu nástroje v GUI; validace běží dál a výsledky se nemění.
    - series: řada (čísla oddělená tečkou), atribut verifiedWith je přesná verze, na které se ověřovalo (jen pro zobrazení);
    - operatingSystem bez series: na platformě není ověřena žádná verze (každá verze je neověřená);
    - operatingSystem s inheritsFrom="MAC": platí seznam jiné platformy s poznámkou „ověřeno na macOS“ (mechanismus
      pro platformu, kterou zatím nikdo neověřil; dnes ho žádný nástroj nepoužívá, Linux má vlastní seznamy);
    - platforma, která chybí (nebo nástroj bez verifiedVersions): seznam není, verze se neoznačuje.
    Seznam se aktualizuje s novou verzí validátoru podle testů s nástroji na Windows, macOS a Linuxu.

    Spuštění nad souborem (execution) může u každého operatingSystem posoudit, zda nástroj soubor opravdu
    zkontroloval. Když ne, validace ohlásí u souboru jednu chybu (ERROR) „nástroj … soubor nezkontroloval: …“.
    - exitCodes: návratový kód. Pád nebo nespuštění nástroje je selhání vždy (Linux a macOS: 126, 127 a 129–159,
      tj. ukončení signálem, např. 134 SIGABRT, 139 SIGSEGV; Windows: kódy NTSTATUS 0xC0000000–0xEFFFFFFF, např.
      0xC0000005 pád, 0xC0000135 chybí DLL). Atribut normal (kódy oddělené mezerou) uvádí běžné kódy nástroje,
      každý jiný kód je pak také selhání. Výstup nástroje se při selhání nevyhodnocuje.
    - processedFileEvidence (atribut stream STDOUT nebo STDERR, obsah regexp): znak, že nástroj soubor zpracoval.
      Když ve výstupu chybí, chyba se ohlásí, jen pokud profil binárního souboru nenašel žádný problém (poškozený
      soubor, u kterého nástroj vypíše chybu, tak dostane jen hlášky profilu).
    - bez elementů (konfigurace starší než 3.0) se nic z toho neposuzuje.
    Běžné kódy jsou změřené na macOS a Linuxu (Debian 13, Ubuntu 24.04); na Windows zatím jen pád.
-->
<externalUtils>
    <util name="JPYLYZER">
        <verifiedVersions>
            <operatingSystem name="MAC">
                <series verifiedWith="2.2.1">2.2</series>
            </operatingSystem>
            <operatingSystem name="WINDOWS">
                <series verifiedWith="2.2.1">2.2</series>
            </operatingSystem>
            <operatingSystem name="LINUX">
                <series verifiedWith="2.2.1">2.2</series>
            </operatingSystem>
        </verifiedVersions>
        <versionDetection>
            <!--jpylyzer 1.17-->
            <!--
            <operatingSystem name="LINUX">
                <command>${UTIL_PATH}jpylyzer &#45;&#45;version</command>
                <parser>
                    <stream>STDERR</stream>
                    <regexp>\A[0-9\.]+$</regexp>
                </parser>
            </operatingSystem>
            <operatingSystem name="WINDOWS">
                <command>${UTIL_PATH}jpylyzer.exe &#45;&#45;version</command>
                <parser>
                    <stream>STDERR</stream>
                    <regexp>\A[0-9\.]+$</regexp>
                </parser>
            </operatingSystem>-->
            <!--zdrojove kody z https://github.com/openpreserve/jpylyzer/releases a spousteni pres python-->
            <!--http://jpylyzer.openpreservation.org//installation.html-->
            <!-- <operatingSystem name="MAC">
                 <command>python ${UTIL_PATH}jpylyzer.py &#45;&#45;version</command>
                 <parser>
                     <stream>STDERR</stream>
                     <regexp>\A[0-9\.]+$</regexp>
                 </parser>
             </operatingSystem>-->

            <!--jpylyzer 2.2.0-->
            <operatingSystem name="LINUX">
                <command>${UTIL_PATH}jpylyzer --version</command>
                <parser>
                    <stream>STDOUT</stream>
                    <regexp>(?s).*</regexp>
                </parser>
            </operatingSystem>
            <operatingSystem name="WINDOWS">
                <command>${UTIL_PATH}jpylyzer.exe --version</command>
                <parser>
                    <stream>STDOUT</stream>
                    <regexp>(?s).*</regexp>
                </parser>
            </operatingSystem>
            <operatingSystem name="MAC">
                <command>${UTIL_PATH}jpylyzer --version</command>
                <parser>
                    <stream>STDOUT</stream>
                    <regexp>(?s).*</regexp>
                </parser>
            </operatingSystem>
        </versionDetection>
        <execution name="jp2k">
            <operatingSystem name="LINUX">
                <command>${UTIL_PATH}jpylyzer jp2In ${TARGET_FILE}</command>
                <parser>
                    <stream>STDOUT</stream>
                    <regexp>(?s).*</regexp>
                </parser>
                <!-- jpylyzer: 0 i u nevalidního JP2; 249, když nemá co kontrolovat (soubor neexistuje) -->
                <exitCodes normal="0"/>
            </operatingSystem>
            <operatingSystem name="WINDOWS">
                <command>${UTIL_PATH}jpylyzer.exe jp2In ${TARGET_FILE}</command>
                <parser>
                    <stream>STDOUT</stream>
                    <regexp>(?s).*</regexp>
                </parser>
                <!-- Windows: kódy neověřeny, jen pád (NTSTATUS 0xC0000000–0xEFFFFFFF) -->
                <exitCodes/>
            </operatingSystem>

            <!--jpylyzer 1.17-->
            <!--<operatingSystem name="MAC">
                <command>python ${UTIL_PATH}jpylyzer.py jp2In ${TARGET_FILE}</command>
                <parser>
                    <stream>STDOUT</stream>
                    <regexp>(?s).*</regexp>
                </parser>
            </operatingSystem>-->

            <!--jpylyzer 2.2.0-->
            <operatingSystem name="MAC">
                <command>${UTIL_PATH}jpylyzer jp2In ${TARGET_FILE}</command>
                <parser>
                    <stream>STDOUT</stream>
                    <regexp>(?s).*</regexp>
                </parser>
                <!-- jpylyzer: 0 i u nevalidního JP2; 249, když nemá co kontrolovat (soubor neexistuje) -->
                <exitCodes normal="0"/>
            </operatingSystem>
        </execution>
    </util>

    <util name="IMAGE_MAGICK">
        <verifiedVersions>
            <operatingSystem name="MAC">
                <series verifiedWith="7.1.2-35">7.1</series>
            </operatingSystem>
            <operatingSystem name="WINDOWS">
                <series verifiedWith="7.1.2-35">7.1</series>
            </operatingSystem>
            <operatingSystem name="LINUX">
                <!-- 6.9.12-98 z Ubuntu 24.04; z PATH píše chyby s názvem programu identify-im6.q16:, profily imageMagick.xml ho zachytí -->
                <series verifiedWith="6.9.12-98">6.9</series>
                <series verifiedWith="7.1.1-43">7.1</series>
            </operatingSystem>
        </verifiedVersions>
        <versionDetection>
            <!--https://gist.github.com/Lammerink/3926636-->
            <operatingSystem name="LINUX">
                <command>${UTIL_PATH}convert -version</command>
                <parser>
                    <stream>STDOUT</stream>
                    <!--<regexp>ImageMagick\s\S*\s\S*</regexp>-->
                    <regexp>ImageMagick [0-9\.\-]+</regexp>
                </parser>
            </operatingSystem>
            <operatingSystem name="WINDOWS">
                <command>${UTIL_PATH}magick.exe convert -version</command>
                <parser>
                    <stream>STDOUT</stream>
                    <!--<regexp>ImageMagick\s\S*\s\S*</regexp>-->
                    <regexp>ImageMagick [0-9\.\-]+</regexp>
                </parser>
            </operatingSystem>
            <!--http://www.imagemagick.org/script/binary-releases.php-->
            <!--instalace pres MacPorts-->
            <operatingSystem name="MAC">
                <command>${UTIL_PATH}convert -version</command>
                <parser>
                    <stream>STDOUT</stream>
                    <regexp>ImageMagick\s\S*\s\S*</regexp>
                </parser>
            </operatingSystem>
        </versionDetection>
        <execution name="jp2k">
            <!--NOTE: if the file is empty, ideentify -verbose doesn't print anything at all-->
            <operatingSystem name="LINUX">
                <command>${UTIL_PATH}identify -verbose ${TARGET_FILE}</command>
                <parser>
                    <stream>STDERR</stream>
                    <regexp>(?s).*</regexp>
                </parser>
                <!-- identify: 0 bez chyby, 1 při chybě čtení (hlášky na stderr hledá profil); u prázdného souboru nebo bez dekodéru skončí 1 bez jediné hlášky, proto znak zpracování „Geometry:“ na stdout -->
                <exitCodes normal="0 1"/>
                <processedFileEvidence stream="STDOUT">(?m)^\s*Geometry: [0-9]</processedFileEvidence>
            </operatingSystem>
            <operatingSystem name="WINDOWS">
                <command>${UTIL_PATH}magick.exe identify -verbose ${TARGET_FILE}</command>
                <parser>
                    <stream>STDERR</stream>
                    <regexp>(?s).*</regexp>
                </parser>
                <!-- Windows: kódy neověřeny, jen pád (NTSTATUS 0xC0000000–0xEFFFFFFF) -->
                <exitCodes/>
            </operatingSystem>
            <operatingSystem name="MAC">
                <command>${UTIL_PATH}identify -verbose ${TARGET_FILE}</command>
                <parser>
                    <!--at least in version 6.9.9 the error message finally goes to STDERR-->
                    <stream>STDERR</stream>
                    <!--<stream>STDOUT</stream>-->
                    <regexp>(?s).*</regexp>
                </parser>
                <!-- identify: 0 bez chyby, 1 při chybě čtení (hlášky na stderr hledá profil); u prázdného souboru nebo bez dekodéru skončí 1 bez jediné hlášky, proto znak zpracování „Geometry:“ na stdout -->
                <exitCodes normal="0 1"/>
                <processedFileEvidence stream="STDOUT">(?m)^\s*Geometry: [0-9]</processedFileEvidence>
            </operatingSystem>
        </execution>
    </util>

