<binaryFileProfile
        xmlns="http://www.nkp.cz/pspValidator/3.0/binaryFileProfile"
        dmf="composed_perio_1.3"
>
<fromText>

        <validation name="no_errors">
            <textDataExtraction resultType="STRING_LIST">
                <allNonempty>
                    <regexp>(?m)^Error.*$</regexp>
                    <regexp>(?ms)^identify(?:-[\w.]+)?:.*?(?=^identify(?:-[\w.]+)?:|\z)</regexp>
                </allNonempty>
            </textDataExtraction>
            <rules>
                <mustNotExist/>
            </rules>
        </validation>

    </fromText>
</binaryFileProfile>