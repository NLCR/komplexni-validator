<?xml version="1.0" encoding="UTF-8"?>
<metadataProfile
    xmlns="http://www.nkp.cz/pspValidator/3.0/metadataProfile"
    name="MODS title of multivolume monographic (AACR2)"
    dmf="emonograph_3.1"
>
    <info>
        <text>DMF Elektronické publikace (monografie) 3.1  očekává MODS verze 3.8. Dále se zde upřesňují očekávaná metadata pro titul vícesvazkové monografie pro záznamy zpracované podle katalogizačních pravidel AACR2.</text>
        <url>http://www.loc.gov/standards/mods/</url>
        <url description="XSD pro MODS 3.8">http://www.loc.gov/standards/mods/v3/mods-3-8.xsd</url>
        <url description="Popis MODS">https://www.loc.gov/standards/mods/userguide/</url>
    </info>

    <namespaces>
        <namespace prefix="mods">http://www.loc.gov/mods/v3</namespace>
    </namespaces>

    <dictionaries>
        <dictionary name="marcRelatorCodes"/>
        <dictionary name="iso6392languageCodes"/>
    </dictionaries>

    <rootElement name="mods:mods">
        <expectedAttributes>
            <attribute name="ID">
                <expectedContent>
                    <value>MODS_TITLE_0001</value>

                </expectedContent>

            </attribute>
            <attribute name="version">
                <expectedContent>
                    <value>3.8</value>

                </expectedContent>

            </attribute>
        </expectedAttributes>
        <expectedElements>
            <element name="mods:titleInfo">
                <expectedAttributes>
                    <attribute name="type" mandatory="false">
                        <expectedContent>
                            <oneOf>
                                <value>abbreviated</value>

                                <value>alternative</value>

                                <value>translated</value>

                                <value>uniform</value>

                            </oneOf>
                        </expectedContent>

                    </attribute>
                </expectedAttributes>
                <expectedElements>
                    <element name="mods:nonSort" mandatory="false">
                        <expectedContent/>

                    </element>

                    <element name="mods:title">
                        <expectedContent/>

                    </element>

                    <element name="mods:subTitle" mandatory="false">
                        <expectedContent/>

                    </element>

                    <element name="mods:partNumber" mandatory="false">
                        <recommendedContent/>

                    </element>

                    <element name="mods:partName" mandatory="false">
                        <recommendedContent/>

                    </element>

                </expectedElements>
            </element>

            <element name="mods:name" mandatory="false">
                <expectedAttributes>
                    <attribute name="type" mandatory="false">
                        <expectedContent>
                            <oneOf>
                                <value>personal</value>

                                <value>corporate</value>

                                <value>conference</value>

                                <value>family</value>

                            </oneOf>
                        </expectedContent>

                    </attribute>
                    <attribute name="usage" mandatory="false">
                        <expectedContent>
                            <value>primary</value>

                        </expectedContent>

                    </attribute>
                </expectedAttributes>
                <expectedElements>
                    <element name="mods:namePart" mandatory="false" specification="@type='date'">
                        <expectedAttributes>
                            <attribute name="type">
                                <expectedContent/>

                            </attribute>
                        </expectedAttributes>
                        <expectedContent/>

                    </element>

                    <element name="mods:namePart" mandatory="false" specification="@type='family'">
                        <expectedAttributes>
                            <attribute name="type">
                                <expectedContent/>

                            </attribute>
                        </expectedAttributes>
                        <expectedContent/>

                    </element>

                    <element name="mods:namePart" mandatory="false" specification="@type='given'">
                        <expectedAttributes>
                            <attribute name="type">
                                <expectedContent/>

                            </attribute>
                        </expectedAttributes>
                        <expectedContent/>

                    </element>

                    <element name="mods:namePart" mandatory="false" specification="@type='termsOfAddress'">
                        <expectedAttributes>
                            <attribute name="type">
                                <expectedContent/>

                            </attribute>
                        </expectedAttributes>
                        <expectedContent/>

                    </element>

                    <element name="mods:namePart" mandatory="false" specification="not(@type)">
                        <expectedContent/>

                    </element>

                    <element name="mods:alternativeName" mandatory="false">
                        <expectedElements>
                            <element name="mods:namePart">
                                <expectedContent/>

                            </element>

                        </expectedElements>
                    </element>

                    <element name="mods:nameIdentifier" mandatory="false">
                        <expectedContent/>

                    </element>

                    <element name="mods:etal" mandatory="false" repeatable="false">
                        <expectedContent/>

                    </element>

                    <element name="mods:role" mandatory="false">
                        <expectedElements>
                            <element name="mods:roleTerm">
                                <expectedAttributes>
                                    <attribute name="type">
                                        <expectedContent>
                                            <value>code</value>

                                        </expectedContent>

                                    </attribute>
                                    <attribute name="authority">
                                        <expectedContent>
                                            <value>marcrelator</value>

                                        </expectedContent>

                                    </attribute>
                                </expectedAttributes>
                                <expectedContent>
                                    <fromDictionary name="marcRelatorCodes"/>

                                </expectedContent>

                            </element>

                        </expectedElements>
                    </element>

                </expectedElements>
            </element>

            <element name="mods:genre" specification=". = 'title' or . = 'electronic title'">
                <expectedContent>
                    <value>electronic title</value>

                </expectedContent>

            </element>

            <element name="mods:genre" mandatory="false" specification="not(. = 'title' or . = 'electronic title')">
                <expectedAttributes>
                    <attribute name="authority" mandatory="false">
                        <recommendedContent>
                            <value>czenas</value>

                        </recommendedContent>

                    </attribute>
                </expectedAttributes>
                <recommendedContent/>

            </element>

            <element name="mods:originInfo">
                <expectedElements>
                    <element name="mods:place" mandatory="false">
                        <expectedElements>
                            <element name="mods:placeTerm" mandatory="false" specification="(@type[. = 'code']) and (not(@type[. = 'text']))">
                                <expectedAttributes>
                                    <attribute name="type">
                                        <expectedContent>
                                            <oneOf>
                                                <value>code</value>

                                                <value>text</value>

                                            </oneOf>
                                        </expectedContent>

                                    </attribute>
                                    <attribute name="authority" mandatory="false">
                                        <expectedContent>
                                            <value>marccountry</value>

                                        </expectedContent>

                                    </attribute>
                                </expectedAttributes>
                                <expectedContent/>

                            </element>

                            <element name="mods:placeTerm" mandatory="false" specification="(not(@type[. = 'code'])) and (@type[. = 'text'])">
                                <expectedAttributes>
                                    <attribute name="type">
                                        <expectedContent>
                                            <oneOf>
                                                <value>code</value>

                                                <value>text</value>

                                            </oneOf>
                                        </expectedContent>

                                    </attribute>
                                </expectedAttributes>
                                <expectedContent/>

                            </element>

                            <element name="mods:placeTerm" mandatory="false" specification="(not(@type[. = 'code'])) and (not(@type[. = 'text']))">
                                <expectedAttributes>
                                    <attribute name="type">
                                        <expectedContent>
                                            <oneOf>
                                                <value>code</value>

                                                <value>text</value>

                                            </oneOf>
                                        </expectedContent>

                                    </attribute>
                                    <attribute name="authority" mandatory="false">
                                        <expectedContent/>

                                    </attribute>
                                </expectedAttributes>
                                <expectedContent/>

                            </element>

                        </expectedElements>
                    </element>

                    <element name="mods:agent" mandatory="false">
                        <expectedElements>
                            <element name="mods:namePart">
                                <expectedContent/>

                            </element>

                            <element name="mods:role" mandatory="false">
                                <expectedElements>
                                    <element name="mods:roleTerm">
                                        <expectedContent>
                                            <oneOf>
                                                <value>publisher</value>

                                                <value>manufacturer</value>

                                            </oneOf>
                                        </expectedContent>

                                    </element>

                                </expectedElements>
                            </element>

                        </expectedElements>
                    </element>

                    <element name="mods:dateIssued">
                        <expectedAttributes>
                            <attribute name="encoding" mandatory="false">
                                <recommendedContent>
                                    <value>marc</value>

                                </recommendedContent>

                            </attribute>
                            <attribute name="point" mandatory="false">
                                <expectedContent>
                                    <oneOf>
                                        <value>start</value>

                                        <value>end</value>

                                    </oneOf>
                                </expectedContent>

                            </attribute>
                            <attribute name="qualifier" mandatory="false">
                                <recommendedContent>
                                    <oneOf>
                                        <value>approximate</value>

                                        <value>inferred</value>

                                        <value>questionable</value>

                                    </oneOf>
                                </recommendedContent>

                            </attribute>
                            <attribute name="calendar" mandatory="false">
                                <expectedContent>
                                    <oneOf>
                                        <value>gregorian</value>

                                        <value>hebrew</value>

                                        <value>julian</value>

                                    </oneOf>
                                </expectedContent>

                            </attribute>
                        </expectedAttributes>
                        <expectedContent/>

                    </element>

                    <element name="mods:dateOther" mandatory="false">
                        <expectedAttributes>
                            <attribute name="type">
                                <expectedContent>
                                    <value>manufacture</value>

                                </expectedContent>

                            </attribute>
                        </expectedAttributes>
                        <recommendedContent/>

                    </element>

                    <element name="mods:copyrightDate" mandatory="false">
                        <recommendedContent/>

                    </element>

                    <element name="mods:edition" mandatory="false">
                        <recommendedContent/>

                    </element>

                </expectedElements>
            </element>

            <element name="mods:language" mandatory="false">
                <expectedAttributes>
                    <attribute name="objectPart" mandatory="false">
                        <expectedContent>
                            <oneOf>
                                <value>summary</value>

                                <value>table of contents</value>

                                <value>accompanying material</value>

                                <value>translation</value>

                            </oneOf>
                        </expectedContent>

                    </attribute>
                </expectedAttributes>
                <expectedElements>
                    <element name="mods:languageTerm">
                        <expectedAttributes>
                            <attribute name="type">
                                <expectedContent>
                                    <value>code</value>

                                </expectedContent>

                            </attribute>
                            <attribute name="authority">
                                <expectedContent>
                                    <value>iso639-2b</value>

                                </expectedContent>

                            </attribute>
                        </expectedAttributes>
                        <expectedContent>
                            <fromDictionary name="iso6392languageCodes"/>

                        </expectedContent>

                    </element>

                </expectedElements>
            </element>

            <element name="mods:physicalDescription">
                <expectedElements>
                    <element name="mods:form">
                        <expectedAttributes>
                            <attribute name="authority">
                                <expectedContent/>

                            </attribute>
                        </expectedAttributes>
                        <expectedContent/>

                    </element>

                    <element name="mods:extent" mandatory="false">
                        <recommendedContent/>

                    </element>

                </expectedElements>
            </element>

            <element name="mods:subject" mandatory="false">
                <expectedAttributes>
                    <attribute name="authority" mandatory="false">
                        <recommendedContent>
                            <oneOf>
                                <value>czenas</value>

                                <value>eczenas</value>

                                <value>mednas</value>

                                <value>czmesh</value>

                                <value>Konspekt</value>

                                <value>msvkth</value>

                                <value>agrovoc</value>

                            </oneOf>
                        </recommendedContent>

                    </attribute>
                </expectedAttributes>
                <expectedElements>
                    <element name="mods:topic" mandatory="false">
                        <expectedAttributes>
                            <attribute name="valueURI" mandatory="false">
                                <recommendedContent/>

                            </attribute>
                        </expectedAttributes>
                        <recommendedContent/>

                    </element>

                    <element name="mods:geographic" mandatory="false">
                        <expectedAttributes>
                            <attribute name="valueURI" mandatory="false">
                                <recommendedContent/>

                            </attribute>
                        </expectedAttributes>
                        <recommendedContent/>

                    </element>

                    <element name="mods:temporal" mandatory="false">
                        <recommendedContent/>

                    </element>

                    <element name="mods:name" mandatory="false">
                        <expectedElements>
                            <element name="mods:namePart">
                                <expectedContent/>

                            </element>

                            <element name="mods:nameIdentifier" mandatory="false">
                                <expectedContent/>

                            </element>

                        </expectedElements>
                    </element>

                </expectedElements>
            </element>

            <element name="mods:classification" mandatory="false">
                <expectedAttributes>
                    <attribute name="authority">
                        <expectedContent>
                            <oneOf>
                                <value>udc</value>

                                <value>Konspekt</value>

                                <value>lcc</value>

                                <value>ddc</value>

                                <value>nlm</value>

                                <value>sudocs</value>

                                <value>candocs</value>

                                <value>contents of $2</value>

                            </oneOf>
                        </expectedContent>

                    </attribute>
                    <attribute name="edition" mandatory="false">
                        <expectedContent>
                            <value>Konspekt</value>

                        </expectedContent>

                    </attribute>
                </expectedAttributes>
                <recommendedContent/>

