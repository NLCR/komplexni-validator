                <expectedAttributes>
                    <attribute name="type">
                        <expectedContent/>

                    </attribute>
                </expectedAttributes>
                <expectedContent/>

            </element>

            <element name="mods:identifier" mandatory="false" specification="
  @type
  and not(
    @type = 'uuid'
    or @type = 'ccnb'
    or @type = 'isbn'
    or @type = 'ismn'
    or @type = 'issn'
  )
">
                <expectedAttributes>
                    <attribute name="type">
                        <expectedContent/>

                    </attribute>
                </expectedAttributes>
                <recommendedContent/>

            </element>

            <element name="mods:identifier" mandatory="false" specification="not(self::mods:identifier[@type = 'uuid'] or self::mods:identifier[@type = 'ccnb'] or self::mods:identifier[@type = 'isbn'] or self::mods:identifier[@type = 'issn'] or self::mods:identifier[@type = 'ismn'] or self::mods:identifier[
  @type
  and not(
    @type = 'uuid'
    or @type = 'ccnb'
    or @type = 'isbn'
    or @type = 'ismn'
    or @type = 'issn'
